<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Панель управления</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: sans-serif; background: #f1f5f9; color: #1e293b; padding: 2rem 1rem; }
    h1   { font-size: 1.4rem; margin-bottom: 2rem; }
    h2   { font-size: 1.1rem; margin-bottom: 1rem; color: #334155; }

    .card {
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0,0,0,.07);
      padding: 1.5rem;
      margin-bottom: 2rem;
    }

    table { width: 100%; border-collapse: collapse; margin-bottom: 1.25rem; }
    th, td { text-align: left; padding: .5rem .75rem; border-bottom: 1px solid #e2e8f0; font-size: .9rem; }
    th { background: #f8fafc; font-weight: 600; }

    .color-dot {
      display: inline-block;
      width: 14px; height: 14px;
      border-radius: 50%;
      border: 1px solid #cbd5e1;
      vertical-align: middle;
      margin-right: 6px;
    }

    form.inline { display: inline; }
    button {
      padding: .3rem .75rem;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      font-size: .85rem;
    }
    .btn-delete { background: #fee2e2; color: #dc2626; }
    .btn-delete:hover { background: #fecaca; }
    .btn-edit { background: #e0f2fe; color: #0369a1; text-decoration: none; padding: .3rem .75rem; border-radius: 6px; font-size: .85rem; }
    .btn-edit:hover { background: #bae6fd; }

    .add-form { display: flex; flex-wrap: wrap; gap: .5rem; align-items: flex-end; }
    .add-form label { display: flex; flex-direction: column; gap: .25rem; font-size: .85rem; font-weight: 500; }
    .add-form input { padding: .4rem .6rem; border: 1px solid #cbd5e1; border-radius: 6px; font-size: .9rem; width: 100%; }
    .add-form input[type="color"] { padding: .15rem .3rem; width: 60px; height: 34px; cursor: pointer; }
    .btn-add { background: #2563eb; color: #fff; padding: .45rem 1rem; align-self: flex-end; }
    .btn-add:hover { background: #1d4ed8; }
    .btn-move { background: #f1f5f9; color: #334155; min-width: 32px; }
    .btn-move:hover { background: #e2e8f0; }
    .btn-move:disabled { opacity: .35; cursor: default; }
    .add-form select { padding: .4rem .6rem; border: 1px solid #cbd5e1; border-radius: 6px; font-size: .9rem; }
    .thumb { width: 44px; height: 32px; object-fit: cover; border-radius: 4px; background: #eef2f7; display: block; }
    .muted { color: #94a3b8; font-size: .8rem; font-weight: 400; }

    .hint { color: #64748b; font-size: .85rem; line-height: 1.45; margin: 0 0 1rem; max-width: 62rem; }
    .hint code { font-size: .8rem; background: #f1f5f9; padding: .1rem .35rem; border-radius: 4px; }
    .file-name { font-family: ui-monospace, Consolas, monospace; font-size: .75rem; color: #64748b; }
    .photo-upload input[type="file"] { font-size: .75rem; max-width: 11rem; }
    .thumb-empty { width: 44px; height: 32px; border-radius: 4px; background: #eef2f7; display: grid; place-items: center; color: #94a3b8; font-size: .7rem; }

    .badge { display: inline-block; padding: .15rem .55rem; border-radius: 99px; background: #f1f5f9; color: #64748b; font-size: .75rem; font-weight: 600; }
    .badge-feat { background: #dbeafe; color: #1d4ed8; }
    .btn-toggle { background: #fef9c3; color: #a16207; }
    .btn-toggle:hover { background: #fef08a; }
    .import-ok { background: #dcfce7; color: #166534; padding: .6rem .9rem; border-radius: 8px; font-size: .9rem; margin-bottom: 1rem; }
    .import-err { background: #fee2e2; color: #b91c1c; padding: .6rem .9rem; border-radius: 8px; font-size: .9rem; margin-bottom: 1rem; }
    .check-inline { display: inline-flex; align-items: center; gap: .4rem; font-size: .85rem; font-weight: 500; padding-bottom: .55rem; }
  </style>
</head>
<body>

<h1>Панель управления</h1>

<!-- ── Заявки с сайта ── -->
<div class="card" id="leads">
  <h2>Заявки с сайта <span class="muted">форма «Написать заявку»</span></h2>
  <% if (!leads || leads.length === 0) { %>
    <p class="empty">Заявок пока нет. Они появятся, когда посетитель отправит форму «Написать заявку».</p>
  <% } else { %>
    <table>
      <thead><tr><th>Дата</th><th>Имя</th><th>Телефон</th><th>Контекст</th><th>Сообщение</th><th>Страница</th><th></th></tr></thead>
      <tbody>
        <% leads.forEach(function(l) { %>
          <tr>
            <td class="file-name"><%= new Date(l.created_at).toLocaleString("ru-RU", { day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit" }) %></td>
            <td><strong><%= l.name %></strong></td>
            <td><a href="tel:<%= String(l.phone).replace(/[^\d+]/g, "") %>"><%= l.phone %></a></td>
            <td class="muted"><%= l.context || "—" %></td>
            <td><%= l.message || "—" %></td>
            <td class="file-name"><%= l.page || "—" %></td>
            <td>
              <form class="inline" method="POST" action="/admin/leads/<%= l.id %>/delete">
                <button class="btn-delete" onclick="return confirm('Удалить заявку от <%= l.name %>?')">Удалить</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<!-- ── Картриджи ── -->
<div class="card" id="cartridges">
  <h2>Картриджи <span class="muted">каталог /kartridzhi</span></h2>
  <p class="hint">
    Распознанные коды создаются из поля «Картридж» моделей. Здесь можно исправить данные и вручную связать расходник с моделями.
    Текстовые описания без кода (например, «чернила GI-серии») автоматически не превращаются в выдуманные модели.
  </p>
  <% if (!cartridges || cartridges.length === 0) { %>
    <p class="empty">Картриджей пока нет.</p>
  <% } else { %>
    <table>
      <thead><tr><th>Бренд</th><th>Модель</th><th>Название</th><th>Другие коды</th><th>Ресурс</th><th>Аналог / примечание</th><th>Тип</th><th>Цвет</th><th>Связанные модели</th><th></th></tr></thead>
      <tbody>
        <% cartridges.forEach(function(c) { %>
          <tr>
            <td><%= c.brand %></td>
            <td class="file-name"><%= c.model %></td>
            <td><input form="cart-<%= c.id %>" name="name" value="<%= c.name %>" style="width:100%;min-width:8rem" /></td>
            <td><input form="cart-<%= c.id %>" name="aliases" value="<%= c.aliases.join(', ') %>" placeholder="CE285A" style="width:100%;min-width:8rem" /></td>
            <td><input form="cart-<%= c.id %>" name="resource_pages" type="number" min="0" value="<%= c.resourcePages || '' %>" style="width:6rem" /></td>
            <td><input form="cart-<%= c.id %>" name="analog_note" value="<%= c.analogNote %>" style="width:100%;min-width:10rem" /></td>
            <td>
              <select form="cart-<%= c.id %>" name="cartridge_type">
                <option value="toner" <%= c.cartridgeType === "toner" ? "selected" : "" %>>тонер</option>
                <option value="ink" <%= c.cartridgeType === "ink" ? "selected" : "" %>>чернила</option>
                <option value="drum" <%= c.cartridgeType === "drum" ? "selected" : "" %>>барабан</option>
                <option value="waste" <%= c.cartridgeType === "waste" ? "selected" : "" %>>отработка</option>
              </select>
            </td>
            <td>
              <select form="cart-<%= c.id %>" name="color">
                <option value="black" <%= c.color === "black" ? "selected" : "" %>>чёрный</option>
                <option value="cyan" <%= c.color === "cyan" ? "selected" : "" %>>cyan</option>
                <option value="magenta" <%= c.color === "magenta" ? "selected" : "" %>>magenta</option>
                <option value="yellow" <%= c.color === "yellow" ? "selected" : "" %>>yellow</option>
                <option value="tri-color" <%= c.color === "tri-color" ? "selected" : "" %>>tri-color</option>
                <option value="set" <%= c.color === "set" ? "selected" : "" %>>цветной набор</option>
              </select>
            </td>
            <td>
              <details>
                <summary>Выбрать (<%= c.printersCount || 0 %>)</summary>
                <select form="cart-<%= c.id %>" name="printer_ids" multiple size="6" style="min-width:14rem;max-width:18rem">
                  <% printerCatalog.forEach(function(p) { %>
                    <option value="<%= p.id %>" <%= (c.printerIds || []).indexOf(p.id) !== -1 ? "selected" : "" %>><%= p.brand %> <%= p.model %></option>
                  <% }); %>
                </select>
              </details>
            </td>
            <td style="display:flex;gap:.4rem;align-items:center;flex-wrap:wrap">
              <button class="btn-toggle" type="submit" form="cart-<%= c.id %>">Сохранить</button>
              <form class="inline" method="POST" action="/admin/cartridges/<%= c.id %>/delete">
                <button class="btn-delete" onclick="return confirm('Удалить картридж <%= c.brand %> <%= c.model %>?')">Удалить</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <% cartridges.forEach(function(c) { %>
      <form id="cart-<%= c.id %>" method="POST" action="/admin/cartridges/<%= c.id %>/update" hidden>
        <input type="hidden" name="model" value="<%= c.model %>" />
      </form>
    <% }); %>
  <% } %>

  <form method="POST" action="/admin/cartridges/add" class="add-form" style="margin-top:1rem">
    <label>Бренд<input name="brand" placeholder="HP" required /></label>
    <label>Модель<input name="model" placeholder="85A" required /></label>
    <label>Тип
      <select name="cartridge_type">
        <option value="toner">тонер</option>
        <option value="ink">чернила</option>
        <option value="drum">барабан</option>
        <option value="waste">отработка</option>
      </select>
    </label>
    <label>Цвет
      <select name="color">
        <option value="black">чёрный</option>
        <option value="cyan">cyan</option>
        <option value="magenta">magenta</option>
        <option value="yellow">yellow</option>
        <option value="tri-color">tri-color</option>
        <option value="set">цветной набор</option>
      </select>
    </label>
    <label>Другие коды<input name="aliases" placeholder="CE285A" /></label>
    <label>Ресурс (стр.)<input name="resource_pages" type="number" min="0" placeholder="1500" /></label>
    <label>Аналог / примечание<input name="analog_note" placeholder="Совместимый код или комментарий" /></label>
    <button class="btn-add" type="submit">Добавить картридж</button>
  </form>
</div>

<!-- ── Отзывы ── -->
<div class="card" id="reviews">
  <h2>Отзывы <span class="muted">на главной, раздел «Отзывы клиентов»</span></h2>
  <p class="hint">Добавляйте только реальные отзывы клиентов — они публикуются на главной странице. Пока отзывов нет, блок не показывается.</p>
  <% if (!reviews || reviews.length === 0) { %>
    <p class="empty">Отзывов пока нет.</p>
  <% } else { %>
    <table>
      <thead><tr><th>Дата</th><th>Автор</th><th>Город</th><th>Оценка</th><th>Текст</th><th>Статус</th><th></th></tr></thead>
      <tbody>
        <% reviews.forEach(function(r) { %>
          <tr>
            <td class="file-name"><%= new Date(r.created_at).toLocaleDateString("ru-RU") %></td>
            <td><strong><%= r.author %></strong></td>
            <td><%= r.city || "—" %></td>
            <td><%= r.rating %>/5</td>
            <td><%= r.text %></td>
            <td><span class="badge <%= r.is_active ? "badge-feat" : "" %>"><%= r.is_active ? "на сайте" : "скрыт" %></span></td>
            <td style="display:flex;gap:.4rem;align-items:center;flex-wrap:wrap">
              <form class="inline" method="POST" action="/admin/reviews/<%= r.id %>/toggle">
                <button class="btn-toggle" type="submit"><%= r.is_active ? "Скрыть" : "Показать" %></button>
              </form>
              <form class="inline" method="POST" action="/admin/reviews/<%= r.id %>/delete">
                <button class="btn-delete" onclick="return confirm('Удалить отзыв <%= r.author %>?')">Удалить</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

  <form method="POST" action="/admin/reviews/add" class="add-form" style="margin-top:1rem">
    <label>Автор<input name="author" placeholder="Иван" required /></label>
    <label>Город<input name="city" placeholder="Курск" /></label>
    <label>Оценка
      <select name="rating">
        <option value="5">5</option>
        <option value="4">4</option>
        <option value="3">3</option>
      </select>
    </label>
    <label style="flex:1 1 260px">Текст отзыва<textarea name="text" rows="2" required style="padding:.4rem .6rem;border:1px solid #cbd5e1;border-radius:6px;font-size:.9rem;width:100%"></textarea></label>
    <button class="btn-add" type="submit">Добавить отзыв</button>
  </form>
</div>

<!-- ── Фото шапки ── -->
<div class="card">
  <h2>Фото шапки</h2>

  <% if (hasHero) { %>
    <div style="margin-bottom:1rem">
      <img src="/hero-bg.jpg" alt="Текущее фото"
           style="max-width:100%;max-height:160px;object-fit:cover;border-radius:8px;display:block;margin-bottom:.75rem" />
      <form class="inline" method="POST" action="/admin/hero-delete">
        <button class="btn-delete" onclick="return confirm('Удалить фото шапки?')">Удалить фото</button>
      </form>
    </div>
  <% } else { %>
    <p class="empty" style="margin-bottom:.75rem">Фото не загружено — шапка показывается синим цветом.</p>
  <% } %>

  <form method="POST" action="/admin/hero-upload" enctype="multipart/form-data" class="add-form">
    <label><%= hasHero ? 'Заменить фото' : 'Загрузить фото' %><input name="hero" type="file" accept="image/*" required style="padding:.3rem 0;border:none" /></label>
    <button class="btn-add" type="submit">Загрузить</button>
  </form>
</div>

<!-- ── Каталог моделей ── -->
<div class="card">
  <h2>Каталог моделей <span class="muted">страница /modeli</span></h2>
  <p class="hint">
    Каждая модель получает свою страницу на сайте и попадает в sitemap.
    Массовое наполнение — CSV-файлом: разделитель <code>;</code> или <code>,</code>, кодировка UTF-8,
    в заголовке колонки brand, model, device_type, print_technology, color_mode, description, paper_format,
    print_speed_ppm, resolution_dpi, is_duplex, is_wifi, is_ethernet, is_usb, release_year, has_adf,
    scan_resolution_dpi, cartridge_note, is_featured (значения «да/нет»).
    Повторный импорт по паре «бренд + модель» обновляет строки, а не дублирует их; пустая ячейка = поле не менять.
    Тот же файл заливается на сервер без браузера: <code>node scripts/import-printers.js файл.csv</code>.
  </p>

  <% if (importResult) { %>
    <p class="<%= importResult.ok ? 'import-ok' : 'import-err' %>"><%= importResult.text %></p>
  <% } %>
  <% if (carouselFull) { %>
    <p class="import-err">В витрине уже <%= featuredMax %> моделей — сначала уберите одну.</p>
  <% } %>

  <form method="POST" action="/admin/printers/import" enctype="multipart/form-data" class="add-form" style="margin-bottom:1.25rem">
    <label>CSV-файл<input name="csv" type="file" accept=".csv,text/csv" required style="padding:.3rem 0;border:none" /></label>
    <button class="btn-add" type="submit">Импортировать</button>
  </form>

  <% if (catalog.length === 0) { %>
    <p class="empty">Каталог пуст. Импортируйте CSV или добавьте модель ниже.</p>
  <% } else { %>
    <table>
      <thead><tr><th>Бренд</th><th>Модель</th><th>Тип</th><th>Картридж</th><th>Где показывается</th><th></th></tr></thead>
      <tbody>
        <% catalog.forEach(function(p) { %>
          <tr>
            <td><%= p.brand %><% if (!p.is_active) { %> <span class="muted">скрыта</span><% } %></td>
            <td><%= p.model %></td>
            <td><%= p.meta %></td>
            <td class="file-name"><%= p.cartridge_note || "—" %></td>
            <td><% if (p.is_featured) { %><span class="badge badge-feat">витрина</span><% } else { %><span class="badge">каталог</span><% } %></td>
            <td style="display:flex;gap:.4rem;align-items:center;flex-wrap:wrap">
              <form class="inline" method="POST" action="/admin/printers/<%= p.id %>/toggle-featured">
                <button class="btn-toggle" type="submit"><%= p.is_featured ? "Из витрины" : "В витрину" %></button>
              </form>
              <a class="btn-edit" href="/admin/featured/<%= p.id %>/edit">Изменить</a>
              <form class="inline" method="POST" action="/admin/printers/<%= p.id %>/delete">
                <button class="btn-delete" onclick="return confirm('Удалить «<%= p.brand %> <%= p.model %>» из каталога? Страница модели перестанет открываться.')">Удалить</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

  <form method="POST" action="/admin/printers/add" class="add-form">
    <label>Бренд<input name="brand" placeholder="HP" required /></label>
    <label>Модель<input name="model" placeholder="LaserJet P1102" required /></label>
    <label>Тип
      <select name="device_type">
        <option value="printer">Принтер</option>
        <option value="mfp">МФУ</option>
      </select>
    </label>
    <label>Печать
      <select name="print_technology">
        <option value="laser">лазер</option>
        <option value="inkjet">струйный</option>
      </select>
    </label>
    <label>Цвет
      <select name="color_mode">
        <option value="mono">ч/б</option>
        <option value="color">цветной</option>
      </select>
    </label>
    <label class="check-inline"><input type="checkbox" name="is_featured" /> в витрину</label>
    <button class="btn-add" type="submit">+ Добавить</button>
  </form>
</div>

<!-- ── Популярные модели ── -->
<div class="card">
  <h2>Популярные модели <span class="muted">на главной, до <%= featuredMax %> штук</span></h2>
  <p class="hint">
    Этот список и есть витрина на сайте: порядок — стрелками, временно убрать — «Изменить» → снять «Показывать на главной», заменить модель — удалить и добавить другую.
    Фото лучше снять с аппаратов в мастерской (свои снимки, без водяных знаков с чужих сайтов).
    Чтобы картинка уехала на сервер вместе с кодом, положите файл в <code>assets/printers/</code> с именем из колонки «файл» и сделайте commit + pull.
    Загрузка через форму остаётся только на этом сервере (<code>public/featured/</code>, в git не попадает).
  </p>

  <% if (featured.length === 0) { %>
    <p class="empty">Нет моделей в витрине. Добавьте первую.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Фото</th>
          <th>Бренд</th>
          <th>Модель</th>
          <th>Файл</th>
          <th>Тип</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% featured.forEach(function(p, i) { %>
          <tr>
            <td>
              <% if (p.imageUrl) { %>
                <img class="thumb" src="<%= p.imageUrl %>" alt="" />
              <% } else { %>
                <span class="thumb-empty">нет</span>
              <% } %>
              <form class="photo-upload" method="POST" action="/admin/featured/<%= p.id %>/photo" enctype="multipart/form-data" style="margin-top:.35rem">
                <input name="photo" type="file" accept="image/jpeg,image/png,image/webp,image/gif" onchange="this.form.submit()" />
              </form>
            </td>
            <td><%= p.brand %><% if (!p.is_active) { %> <span class="muted">скрыта</span><% } %></td>
            <td><%= p.model %></td>
            <td class="file-name"><%= p.imageFile %></td>
            <td><%= p.meta %></td>
            <td style="display:flex;gap:.35rem;align-items:center;flex-wrap:wrap">
              <form class="inline" method="POST" action="/admin/featured/<%= p.id %>/move">
                <input type="hidden" name="dir" value="up" />
                <button class="btn-move" type="submit" <%= i === 0 ? 'disabled' : '' %>>↑</button>
              </form>
              <form class="inline" method="POST" action="/admin/featured/<%= p.id %>/move">
                <input type="hidden" name="dir" value="down" />
                <button class="btn-move" type="submit" <%= i === featured.length - 1 ? 'disabled' : '' %>>↓</button>
              </form>
              <a class="btn-edit" href="/admin/featured/<%= p.id %>/edit">Изменить</a>
              <form class="inline" method="POST" action="/admin/featured/<%= p.id %>/delete">
                <button class="btn-delete" onclick="return confirm('Убрать «<%= p.brand %> <%= p.model %>» с витрины?')">Удалить</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

  <% if (featured.length < featuredMax) { %>
    <form method="POST" action="/admin/featured/add" class="add-form">
      <label>Бренд<input name="brand" placeholder="HP" required /></label>
      <label>Модель<input name="model" placeholder="LaserJet P1102" required /></label>
      <label>Тип
        <select name="device_type">
          <option value="printer">Принтер</option>
          <option value="mfp">МФУ</option>
        </select>
      </label>
      <label>Печать
        <select name="print_technology">
          <option value="laser">лазер</option>
          <option value="inkjet">струйный</option>
        </select>
      </label>
      <label>Цвет
        <select name="color_mode">
          <option value="mono">ч/б</option>
          <option value="color">цветной</option>
        </select>
      </label>
      <button class="btn-add" type="submit">+ Добавить</button>
    </form>
  <% } else { %>
    <p class="empty">Витрина заполнена (<%= featuredMax %>). Удалите или замените модель, чтобы добавить другую.</p>
  <% } %>
</div>

<!-- ── Услуги ── -->
<div class="card">
  <h2>Услуги</h2>
  <p class="hint">
    Клик по строке на главной открывает карточку услуги: фото детали сверху, описание ниже.
    Фото лучше снять с детали в мастерской. Чтобы картинка уехала с кодом, положите файл в
    <code>assets/services/</code> с именем из колонки «файл».
    Загрузка через форму остаётся только на этом сервере (<code>public/service-photos/</code>, в git не попадает).
  </p>

  <% if (services.length === 0) { %>
    <p class="empty">Нет услуг. Добавьте первую.</p>
  <% } else { %>
    <table>
      <thead><tr><th>Фото</th><th>Название</th><th>Цена, ₽</th><th>Файл</th><th></th></tr></thead>
      <tbody>
        <% services.forEach(function(s) { %>
          <tr>
            <td>
              <% if (s.imageUrl) { %>
                <img class="thumb" src="<%= s.imageUrl %>" alt="" />
              <% } else { %>
                <span class="thumb-empty">нет</span>
              <% } %>
              <form class="photo-upload" method="POST" action="/admin/services/<%= s.id %>/photo" enctype="multipart/form-data" style="margin-top:.35rem">
                <input name="photo" type="file" accept="image/jpeg,image/png,image/webp,image/gif" onchange="this.form.submit()" />
              </form>
            </td>
            <td><%= s.name %></td>
            <td><%= s.price %></td>
            <td class="file-name"><%= s.imageFile %></td>
            <td style="display:flex;gap:.4rem;align-items:center">
              <a class="btn-edit" href="/admin/services/<%= s.id %>/edit">Изменить</a>
              <form class="inline" method="POST" action="/admin/services/<%= s.id %>/delete">
                <button class="btn-delete" onclick="return confirm('Удалить «<%= s.name %>»?')">Удалить</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

  <form method="POST" action="/admin/services/add" class="add-form">
    <label>Название<input name="name" placeholder="Ремонт холодильника" required /></label>
    <label>Цена (₽)<input name="price" type="number" min="0" step="0.01" placeholder="1000" required style="width:120px" /></label>
    <button class="btn-add" type="submit">+ Добавить</button>
  </form>
</div>

<!-- ── Контакты ── -->
<div class="card">
  <h2>Кнопки контактов</h2>

  <% if (contacts.length === 0) { %>
    <p class="empty">Нет контактов. Добавьте первый.</p>
  <% } else { %>
    <table>
      <thead><tr><th>#</th><th>Подпись</th><th>Ссылка</th><th>Цвет</th><th></th></tr></thead>
      <tbody>
        <% contacts.forEach(function(c) { %>
          <tr>
            <td><%= c.id %></td>
            <td><%= c.type %></td>
            <td style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= c.url %></td>
            <td><span class="color-dot" style="background:<%= c.color %>"></span><%= c.color %></td>
            <td style="display:flex;gap:.4rem;align-items:center">
              <a class="btn-edit" href="/admin/contacts/<%= c.id %>/edit">Изменить</a>
              <form class="inline" method="POST" action="/admin/contacts/<%= c.id %>/delete">
                <button class="btn-delete" onclick="return confirm('Удалить «<%= c.type %>»?')">Удалить</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>

  <form method="POST" action="/admin/contacts/add" class="add-form" id="contact-form"
        onsubmit="return buildContactUrl()">

    <label>Тип
      <select id="kind" onchange="onKindChange()" style="padding:.4rem .6rem;border:1px solid #cbd5e1;border-radius:6px;font-size:.9rem">
        <option value="phone">📞 Телефон</option>
        <option value="email">✉️ Email</option>
        <option value="telegram">✈️ Telegram</option>
        <option value="whatsapp">💬 WhatsApp</option>
        <option value="site">🌐 Сайт</option>
        <option value="other">🔗 Другое</option>
      </select>
    </label>

    <label>Подпись
      <input name="type" id="contact-label" value="📞 Позвонить" required />
    </label>

    <label id="value-wrap">Номер телефона
      <input id="contact-value" placeholder="+7 900 123-45-67" required style="width:180px" />
    </label>

    <input name="url" id="contact-url" type="hidden" />

    <label>Цвет фона<input name="color" type="color" value="#2563eb" /></label>
    <button class="btn-add" type="submit">+ Добавить</button>
  </form>
</div>

<script>
const KINDS = {
  phone:    { label: '📞 Позвонить', field: 'Номер телефона', placeholder: '+7 900 123-45-67' },
  email:    { label: '✉️ Email',     field: 'Email адрес',    placeholder: 'zapravka@mail.ru' },
  telegram: { label: '✈️ Telegram',  field: 'Username',       placeholder: 'username (без @)' },
  whatsapp: { label: '💬 WhatsApp',  field: 'Номер телефона', placeholder: '79001234567'       },
  site:     { label: '🌐 Сайт',      field: 'Адрес сайта',   placeholder: 'example.com'       },
  other:    { label: '',             field: 'Ссылка',         placeholder: 'https://...'       },
};

function onKindChange() {
  const k = document.getElementById('kind').value;
  const info = KINDS[k];
  document.getElementById('contact-label').value      = info.label;
  document.getElementById('contact-value').placeholder = info.placeholder;
  document.getElementById('value-wrap').childNodes[0].textContent = info.field;
}

function buildContactUrl() {
  const kind  = document.getElementById('kind').value;
  const raw   = document.getElementById('contact-value').value.trim();
  let url = raw;

  if (kind === 'phone') {
    const digits = raw.replace(/[^\d+]/g, '');
    url = 'tel:' + (digits.startsWith('+') ? digits : '+7' + digits.replace(/^[87]/, ''));
  } else if (kind === 'email') {
    url = raw.startsWith('mailto:') ? raw : 'mailto:' + raw;
  } else if (kind === 'telegram') {
    url = 'https://t.me/' + raw.replace(/^@/, '');
  } else if (kind === 'whatsapp') {
    url = 'https://wa.me/' + raw.replace(/[^\d]/g, '');
  } else if (kind === 'site') {
    url = /^https?:\/\//.test(raw) ? raw : 'https://' + raw;
  }

  document.getElementById('contact-url').value = url;
  return true;
}
</script>

</body>
</html>
