<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Редактирование услуги</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: sans-serif; background: #f1f5f9; color: #1e293b; padding: 2rem 1rem; }
    h1   { font-size: 1.2rem; margin-bottom: 1.5rem; }

    .card {
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0,0,0,.07);
      padding: 1.5rem;
      max-width: 560px;
    }

    .field { display: flex; flex-direction: column; gap: .3rem; margin-bottom: 1rem; }
    label  { font-size: .85rem; font-weight: 600; }
    input, textarea { padding: .5rem .7rem; border: 1px solid #cbd5e1; border-radius: 6px; font-size: .95rem; font-family: inherit; }
    input:focus, textarea:focus { outline: 2px solid #2563eb; border-color: transparent; }
    textarea { resize: vertical; min-height: 10rem; }
    .check { flex-direction: row; align-items: center; gap: .5rem; font-weight: 500; }
    .preview { max-width: 100%; max-height: 160px; object-fit: contain; border-radius: 8px; background: #eef2f7; margin-bottom: .5rem; display: block; }
    .hint { font-size: .8rem; color: #64748b; line-height: 1.45; }
    .hint code { font-size: .75rem; background: #f1f5f9; padding: .1rem .35rem; border-radius: 4px; }

    .actions { display: flex; gap: .6rem; margin-top: 1.25rem; }
    button[type="submit"] {
      background: #2563eb; color: #fff;
      border: none; border-radius: 6px;
      padding: .5rem 1.2rem; font-size: .95rem; cursor: pointer;
    }
    button[type="submit"]:hover { background: #1d4ed8; }
    a.cancel {
      display: inline-flex; align-items: center;
      color: #64748b; font-size: .9rem; text-decoration: none;
      padding: .5rem .75rem; border-radius: 6px;
    }
    a.cancel:hover { background: #f1f5f9; }
  </style>
</head>
<body>

<h1>Услуга</h1>

<div class="card">
  <form method="POST" action="/admin/services/<%= service.id %>/edit" enctype="multipart/form-data">

    <div class="field">
      <label for="name">Название</label>
      <input id="name" name="name" type="text" value="<%= service.name %>" required />
    </div>

    <div class="field">
      <label for="price">Цена (₽)</label>
      <input id="price" name="price" type="number" min="0" step="0.01" value="<%= service.price %>" required />
    </div>

    <div class="field">
      <label>Фото детали</label>
      <% if (service.imageUrl) { %>
        <img class="preview" src="<%= service.imageUrl %>" alt="" />
        <% if (service.imageSource === 'upload') { %>
          <span class="hint">Загружено на этот сервер</span>
          <label class="check"><input type="checkbox" name="remove_photo" /> Удалить загруженное фото</label>
        <% } else { %>
          <span class="hint">Файл из репозитория: assets/services/<%= service.imageFile %></span>
        <% } %>
      <% } else { %>
        <span class="hint">Пока схема. Положите снимок как <code>assets/services/<%= service.imageFile %></code> или загрузите файл ниже.</span>
      <% } %>
      <input name="photo" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
    </div>

    <div class="field">
      <label for="description">Описание (для чего деталь, как часто ломается, производители)</label>
      <textarea id="description" name="description" rows="10" maxlength="4000"
                placeholder="Что это за деталь, зачем нужна, типичные поломки, какие бренды бывают"><%= service.description || '' %></textarea>
    </div>

    <div class="actions">
      <button type="submit">Сохранить</button>
      <a class="cancel" href="/home">← Отмена</a>
    </div>
  </form>
</div>

</body>
</html>
