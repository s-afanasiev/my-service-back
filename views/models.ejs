<!DOCTYPE html>
<html lang="ru">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/page-top') %>

  <nav class="crumbs" aria-label="Навигация">
    <a href="/">Главная</a> / Каталог моделей
  </nav>

  <article class="detail">
    <div class="detail-card">
      <h1><%= heading %></h1>
      <p class="detail-desc">Проверенные модели, которые чаще всего приносят в ремонт. Для каждой — характеристики, картридж и цены на заправку. Не нашли свою модель? Позвоните — заправим почти любую.</p>

      <% if (groups.length) { %>
        <div class="cat-tools" data-cat-tools>
          <div class="cat-search-wrap">
            <input type="search"
                   class="cat-search"
                   data-cat-search
                   placeholder="Поиск по модели или картриджу (например: P1102, 85A, MF3010)..."
                   autocomplete="off"
                   aria-label="Поиск по модели или картриджу" />
          </div>
          <div class="cat-chips" role="group" aria-label="Фильтр по бренду">
            <button type="button" class="cat-chip is-active" data-brand-filter="all">Все (<%= groups.reduce(function(n, g) { return n + g.items.length; }, 0) %>)</button>
            <% groups.forEach(function(g) { %>
              <button type="button"
                      class="cat-chip"
                      data-brand-filter="<%= g.brandSlug %>"
                      style="--accent: var(--brand-<%= g.brandSlug %>, var(--primary))">
                <%= g.brand %> (<%= g.items.length %>)
              </button>
            <% }); %>
          </div>
          <p class="cat-count" data-cat-count hidden></p>
        </div>
        <div class="empty-state" data-cat-empty hidden>
          Ничего не найдено. Попробуйте ввести часть названия модели или позвоните нам — заправим и отремонтируем почти любой аппарат.
          <p class="cat-reset-wrap"><button type="button" class="cat-chip cat-reset" data-cat-reset>Сбросить фильтр</button></p>
        </div>
      <% } %>

      <% if (!groups.length) { %>
        <div class="empty-state">Модели пока не добавлены.</div>
      <% } else { %>
        <% groups.forEach(function(g) { %>
          <section class="cat-brand" aria-label="<%= g.brand %>" data-brand-section="<%= g.brandSlug %>">
            <h2 class="cat-brand-title">
              <span class="cat-brand-dot" style="--accent: var(--brand-<%= g.brandSlug %>, var(--primary))"></span><%= g.brand %>
            </h2>
            <ul class="cat-grid">
              <% g.items.forEach(function(p) { %>
                <li data-model-item
                    data-brand="<%= g.brandSlug %>"
                    data-slug="<%= p.slug %>"
                    data-page="/modeli/<%= p.slug %>"
                    data-brand-name="<%= g.brand %>"
                    data-model-name="<%= p.model %>"
                    data-search="<%= (p.brand + ' ' + p.model + ' ' + (p.cartridge_note || '') + ' ' + p.meta + ' ' + (p.device_type === 'mfp' ? 'мфу сканер копир' : 'принтер') + ' ' + (p.print_technology === 'inkjet' ? 'струйный струйная' : 'лазерный лазер лазерная') + ' ' + (p.color_mode === 'color' ? 'цветной цветная' : 'чб чёрно-белый черно-белый монохромный моно')).toLowerCase() %>">
                  <a class="cat-card" href="/modeli/<%= p.slug %>">
                    <span class="cat-art" style="--accent: var(--brand-<%= g.brandSlug %>, var(--primary))">
                      <% if (p.imageUrl) { %>
                        <img src="<%= p.imageUrl %>" alt="<%= p.brand %> <%= p.model %>" width="240" height="150" loading="lazy" decoding="async" />
                      <% } else { %>
                        <svg class="printer-svg" viewBox="0 0 200 128" fill="none" aria-hidden="true">
                          <rect class="printer-lid" x="38" y="10" width="124" height="18" rx="4" />
                          <rect class="printer-body" x="28" y="32" width="144" height="72" rx="10" />
                          <rect class="printer-window" x="46" y="44" width="108" height="36" rx="4" />
                          <rect class="printer-paper" x="58" y="50" width="84" height="24" rx="2" />
                          <rect class="printer-tray" x="40" y="96" width="120" height="10" rx="3" />
                          <circle class="printer-dot" cx="48" cy="88" r="3.5" />
                          <g class="printer-cmyk">
                            <circle cx="148" cy="88" r="3.5" /><circle cx="158" cy="88" r="3.5" /><circle cx="168" cy="88" r="3.5" />
                          </g>
                        </svg>
                      <% } %>
                    </span>
                    <span class="cat-model"><%= p.model %></span>
                    <span class="cat-meta"><%= p.meta %></span>
                    <% if (p.cartridge_note) { %>
                      <span class="cat-cartridge">Картридж: <%= p.cartridge_note %></span>
                    <% } %>
                  </a>
                </li>
              <% }); %>
            </ul>
          </section>
        <% }); %>
      <% } %>
    </div>
  </article>

  <%# Модалка принтера с листанием по каталогу (задача 12.2) %>
  <%- include('partials/printer-modal') %>
  <%- include('partials/printer-modal-js') %>

  <%- include('partials/footer') %>

  <script>
  (function () {
    var searchInput = document.querySelector("[data-cat-search]");
    var chips = [].slice.call(document.querySelectorAll("[data-brand-filter]"));
    var sections = [].slice.call(document.querySelectorAll("[data-brand-section]"));
    var emptyBox = document.querySelector("[data-cat-empty]");
    var countBox = document.querySelector("[data-cat-count]");
    var resetBtn = document.querySelector("[data-cat-reset]");
    if (!searchInput || !sections.length) return;

    var activeBrand = "all";
    var totalItems = sections.reduce(function (n, sec) {
      return n + sec.querySelectorAll("[data-model-item]").length;
    }, 0);

    // Нормализация (задача 10.1): нижний регистр, ё→е, отдельные токены.
    // «hp 1102», «p-1102», «85a», «tn 1075», «мфу canon» должны находить свои модели.
    function norm(s) {
      return String(s || "").toLowerCase().replace(/ё/g, "е").replace(/[^a-zа-я0-9]+/g, "");
    }
    function tokens(q) {
      return String(q || "").toLowerCase().replace(/ё/g, "е").split(/[^a-zа-я0-9]+/).filter(Boolean);
    }

    // Состояние фильтра в URL (задача 10.2): ?brand=hp&q=85a
    function syncUrl() {
      var q = searchInput.value.replace(/^\s+|\s+$/g, "");
      var params = [];
      if (activeBrand !== "all") params.push("brand=" + encodeURIComponent(activeBrand));
      if (q) params.push("q=" + encodeURIComponent(q));
      var url = window.location.pathname + (params.length ? "?" + params.join("&") : "");
      window.__CATALOG_STATE_URL = url;
      if (window.history && history.replaceState) history.replaceState(null, "", url);
    }

    function applyFilter() {
      var toks = tokens(searchInput.value);
      var totalVisible = 0;

      sections.forEach(function (sec) {
        var brandMatch = activeBrand === "all" || sec.getAttribute("data-brand-section") === activeBrand;
        var items = [].slice.call(sec.querySelectorAll("[data-model-item]"));
        var visibleInSec = 0;

        items.forEach(function (li) {
          var hay = norm(li.getAttribute("data-search") || "");
          var show = brandMatch && toks.every(function (t) { return hay.indexOf(t) !== -1; });
          li.hidden = !show;
          if (show) visibleInSec++;
        });

        sec.hidden = visibleInSec === 0;
        totalVisible += visibleInSec;
      });

      if (emptyBox) emptyBox.hidden = totalVisible > 0;
      if (countBox) {
        if (toks.length || activeBrand !== "all") {
          countBox.hidden = false;
          countBox.textContent = "Найдено " + totalVisible + " из " + totalItems;
        } else {
          countBox.hidden = true;
        }
      }
      syncUrl();
    }

    // восстановление состояния из URL при загрузке
    (function initFromUrl() {
      var mBrand = /[?&]brand=([^&]*)/.exec(window.location.search);
      var mQuery = /[?&]q=([^&]*)/.exec(window.location.search);
      if (mBrand) {
        var brand = decodeURIComponent(mBrand[1]);
        var known = chips.some(function (c) { return c.getAttribute("data-brand-filter") === brand; });
        if (known) {
          activeBrand = brand;
          chips.forEach(function (c) { c.classList.toggle("is-active", c.getAttribute("data-brand-filter") === brand); });
        }
      }
      if (mQuery) searchInput.value = decodeURIComponent(mQuery[1]);
    })();

    searchInput.addEventListener("input", applyFilter);

    chips.forEach(function (chip) {
      chip.addEventListener("click", function () {
        activeBrand = chip.getAttribute("data-brand-filter") || "all";
        chips.forEach(function (c) { c.classList.toggle("is-active", c === chip); });
        applyFilter();
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener("click", function () {
        searchInput.value = "";
        activeBrand = "all";
        chips.forEach(function (c) { c.classList.toggle("is-active", c.getAttribute("data-brand-filter") === "all"); });
        applyFilter();
        searchInput.focus();
      });
    }

    applyFilter();
  })();
  </script>

  <%# Листание моделей прямо из каталога (задача 12.2) — общий контроллер %>
  <%- include('partials/printer-catalog-js') %>
</body>
</html>
