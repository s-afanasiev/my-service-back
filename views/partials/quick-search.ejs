<%# Быстрый переход Ctrl+K (задача 12.3): поиск по моделям, картриджам и услугам.
    Данные — GET /api/search. Триггеры: Ctrl/Cmd+K и кнопка [data-qs-open]. %>
<div class="quick-search" data-quick-search hidden>
  <div class="quick-search-backdrop" data-qs-close></div>
  <div class="quick-search-dialog" role="dialog" aria-modal="true" aria-label="Быстрый поиск по сайту">
    <input type="search"
           class="quick-search-input"
           data-qs-input
           placeholder="Поиск: модель, картридж или услуга (например: P1102, 85A, заправка)…"
           aria-label="Поиск по сайту"
           autocomplete="off" />
    <ul class="quick-search-results" data-qs-results></ul>
    <p class="quick-search-hint">↑ ↓ — выбор · Enter — перейти · Esc — закрыть</p>
  </div>
</div>

<script>
(function () {
  var modal = document.querySelector("[data-quick-search]");
  if (!modal) return;

  var input = modal.querySelector("[data-qs-input]");
  var resultsBox = modal.querySelector("[data-qs-results]");
  var lastFocus = null;
  var items = [];
  var activeIdx = 0;
  var timer = null;

  function open() {
    lastFocus = document.activeElement;
    modal.hidden = false;
    document.body.classList.add("modal-open");
    input.value = "";
    render([]);
    input.focus();
  }

  function close() {
    if (!modal || modal.hidden) return;
    modal.hidden = true;
    document.body.classList.remove("modal-open");
    if (lastFocus && lastFocus.focus) {
      try { lastFocus.focus(); } catch (err) {}
    }
  }

  function render(list) {
    items = list || [];
    activeIdx = 0;
    resultsBox.innerHTML = "";
    items.forEach(function (item, i) {
      var li = document.createElement("li");
      var a = document.createElement("a");
      a.className = "quick-search-item" + (i === 0 ? " is-active" : "");
      a.href = item.url;
      var badge = document.createElement("span");
      badge.className = "quick-search-type";
      badge.textContent = item.type;
      var title = document.createElement("span");
      title.className = "quick-search-title";
      title.textContent = item.title;
      var sub = document.createElement("span");
      sub.className = "quick-search-sub";
      sub.textContent = item.sub || "";
      a.appendChild(badge);
      a.appendChild(title);
      a.appendChild(sub);
      li.appendChild(a);
      resultsBox.appendChild(li);
    });
    if (!items.length && input.value.trim().length >= 2) {
      var li = document.createElement("li");
      li.className = "quick-search-empty";
      li.textContent = "Ничего не найдено";
      resultsBox.appendChild(li);
    }
  }

  function moveActive(delta) {
    var links = [].slice.call(resultsBox.querySelectorAll(".quick-search-item"));
    if (!links.length) return;
    activeIdx = (activeIdx + delta + links.length) % links.length;
    links.forEach(function (a, i) { a.classList.toggle("is-active", i === activeIdx); });
    links[activeIdx].scrollIntoView({ block: "nearest" });
  }

  function search() {
    var q = input.value.trim();
    if (q.length < 2) { render([]); return; }
    fetch("/api/search?q=" + encodeURIComponent(q))
      .then(function (r) { return r.ok ? r.json() : Promise.reject(); })
      .then(function (d) { render(d.items || []); })
      .catch(function () { render([]); });
  }

  document.addEventListener("click", function (e) {
    if (e.target.closest && e.target.closest("[data-qs-open]")) {
      e.preventDefault();
      open();
      return;
    }
    if (e.target.closest && e.target.closest("[data-qs-close]")) {
      e.preventDefault();
      close();
    }
  });

  document.addEventListener("keydown", function (e) {
    if ((e.ctrlKey || e.metaKey) && (e.key === "k" || e.key === "K" || e.code === "KeyK")) {
      e.preventDefault();
      if (modal.hidden) open(); else close();
      return;
    }
    if (modal.hidden) return;
    if (e.key === "Escape") {
      e.preventDefault();
      close();
      return;
    }
    if (e.key === "Tab" && window.ModalFocus) {
      ModalFocus.trap(modal.querySelector(".quick-search-dialog"), e);
      return;
    }
    if (e.key === "ArrowDown") { e.preventDefault(); moveActive(1); return; }
    if (e.key === "ArrowUp") { e.preventDefault(); moveActive(-1); return; }
    if (e.key === "Enter") {
      var links = [].slice.call(resultsBox.querySelectorAll(".quick-search-item"));
      if (links[activeIdx]) {
        e.preventDefault();
        window.location.href = links[activeIdx].getAttribute("href");
      }
    }
  });

  input.addEventListener("input", function () {
    if (timer) clearTimeout(timer);
    timer = setTimeout(search, 150);
  });
})();
</script>
