  }
  .service-brand-banner.is-nvprint .service-brand-banner-logo,
  .service-brand-banner.is-cactus .service-brand-banner-logo,
  .service-brand-banner.is-easyprint .service-brand-banner-logo,
  .service-brand-banner.is-gg .service-brand-banner-logo,
  .service-brand-banner.is-superfine .service-brand-banner-logo,
  .service-brand-banner.is-gala .service-brand-banner-logo,
