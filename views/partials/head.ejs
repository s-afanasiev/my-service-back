<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />

<!-- ── Основные SEO-теги ── -->
<title><%= title %><%= siteName ? " | " + siteName : "" %></title>
<meta name="description" content="<%= description %>" />
<% if (typeof pageUrl !== "undefined" && pageUrl) { %><link rel="canonical" href="<%= pageUrl %>" /><% } else if (siteUrl) { %><link rel="canonical" href="<%= siteUrl %>/" /><% } %>

<!-- ── Open Graph (Facebook, VK, Telegram-превью) ── -->
<meta property="og:type"        content="website" />
<meta property="og:title"       content="<%= title %><%= siteName ? " | " + siteName : "" %>" />
<meta property="og:description" content="<%= description %>" />
<% if (typeof pageUrl !== "undefined" && pageUrl) { %><meta property="og:url" content="<%= pageUrl %>" /><% } else if (siteUrl) { %><meta property="og:url" content="<%= siteUrl %>/" /><% } %>
<% if (ogImage) { %><meta property="og:image" content="<%= ogImage %>" /><% } %>
<meta property="og:locale"      content="ru_RU" />

<!-- ── JSON-LD ── -->
<% if (typeof jsonLd !== "undefined" && jsonLd) { %>
<script type="application/ld+json"><%- jsonLd %></script>
<% } %>

