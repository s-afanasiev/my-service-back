    padding: .15rem .4rem;
  }
  .service-brand-chip.is-easyprint img { height: 32px; }
  .service-brand-chip.is-gg {
    background: #000;
    border-color: #0066b2;
    min-width: 92px;
  }
  .service-brand-chip.is-profiline {
    background: #fff;
