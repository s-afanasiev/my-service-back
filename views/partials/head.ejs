    background: #7a1218;
    color: #fff;
    box-shadow: inset 0 4px 0 #f48024, 0 2px 10px rgba(43, 56, 128, .08);
  }
  .service-brand-banner.is-easyprint .service-brand-banner-text { color: #fde8e8; }
  .service-brand-banner.is-easyprint .service-brand-back { background: #f48024; color: #fff; }
