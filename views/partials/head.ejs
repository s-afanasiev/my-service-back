    color: #fff;
  }
  .service-brand-banner.is-netproduct .service-brand-banner-text { color: #e8eef8; }
  .service-brand-banner.is-netproduct .service-brand-back { background: #fff; color: #163a73; }
  .service-brand-banner.is-netproduct .service-brand-banner-logo { height: 36px; }
  .service-brand-banner-head {
    display: flex;
    align-items: center;
    gap: .45rem;
    flex: 0 0 auto;
    margin: 0 0 .45rem;
  }
  .service-brand-banner-logo {
    height: 22px;
    width: auto;
    max-width: 120px;
    object-fit: contain;
  }
  .service-brand-banner.is-7quality .service-brand-banner-logo { height: 36px; }
  .service-brand-back {
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
    border: none;
    border-radius: 50%;
    background: #f1f5f9;
    color: #334155;
    font-size: 1.05rem;
    line-height: 1;
    cursor: pointer;
  }
  .service-brand-back:hover { filter: brightness(1.08); }
  .service-brand-banner-head h5 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -.2px;
    line-height: 1.2;
  }
  .service-brand-banner-text {
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    font-size: .88rem;
    line-height: 1.5;
    color: var(--text);
    white-space: pre-wrap;
    -webkit-overflow-scrolling: touch;
  }
  .service-modal-photo {
    min-height: 0;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    overflow: hidden;
    background: #f8fafc;
  }
  .service-modal-photo .service-art {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8fafc;
  }
  .service-modal-photo img,
  .service-modal-photo .service-art img {
    width: auto !important;
    height: auto !important;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
    background: transparent;
    flex: 0 1 auto;
    min-width: 0;
    min-height: 0;
  }
  .service-modal-photo .service-svg { width: min(320px, 86%); height: auto; }
  .service-modal-hero.is-photo-only .service-svg { width: min(560px, 92%); }
  .service-modal-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin: 0 0 .55rem;
  }
  .service-modal-dialog h3 {
    margin: 0;
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -.3px;
    line-height: 1.25;
    flex: 1 1 auto;
  }
  .service-modal-price {
    white-space: nowrap;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--primary);
    background: #eff6ff;
    padding: .3rem .8rem;
    border-radius: 8px;
  }
  .service-modal-dialog h4 {
    margin: 0 0 .4rem;
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .service-modal-desc-block {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }
  .service-modal-desc {
    font-size: .98rem;
    line-height: 1.55;
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    color: var(--text);
    white-space: pre-wrap;
    -webkit-overflow-scrolling: touch;
  }
  .service-modal-desc:empty::after {
    content: "Описание пока не заполнено.";
    color: var(--muted);
  }

  .empty-state {
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 2.5rem;
    text-align: center;
    color: var(--muted);
  }

  /* ── витрина популярных моделей ── */
  .featured {
    margin: 2.25rem 0 0.5rem;
    overflow: hidden;
  }
  .featured-head {
    max-width: 760px;
    margin: 0 auto 1.1rem;
    padding: 0 1rem;
  }
  .featured-head h2 {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -.3px;
  }
  .featured-head p {
    margin-top: .35rem;
