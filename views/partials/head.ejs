<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= title %></title>
<meta name="description" content="<%= description %>" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg:      #f5f6fa;
    --surface: #ffffff;
    --primary: #2563eb;
    --primary-dark: #1d4ed8;
    --text:    #1e293b;
    --muted:   #64748b;
    --radius:  14px;
    --shadow:  0 2px 16px rgba(0,0,0,.07);
  }

  body {
    font-family: "Inter", sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
  }

  /* ── общий контейнер ── */
  .container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* ── шапка ── */
  .site-header {
    background: var(--primary);
    color: #fff;
    padding: 3rem 1.5rem 4rem;
    text-align: center;
  }
  .site-header h1 { font-size: 2rem; font-weight: 700; letter-spacing: -.5px; }
  .site-header .lead { margin-top: .6rem; opacity: .88; font-size: 1.05rem; line-height: 1.5; max-width: 540px; margin-inline: auto; }

  /* ── кнопки-контакты ── */
  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem;
    justify-content: center;
    margin-top: 1.5rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .55rem 1.1rem;
    border-radius: 8px;
    font-size: .9rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity .15s, transform .15s;
  }
  .btn:hover { opacity: .88; transform: translateY(-1px); }
  .btn-phone  { background: #fff;      color: var(--primary-dark); }
  .btn-wa     { background: #25d366;   color: #fff; }
  .btn-tg     { background: #29b6f6;   color: #fff; }

  /* ── блоки страницы ── */
  .section {
    margin: -2rem auto 2.5rem;
    padding: 0 1rem;
    max-width: 760px;
  }
  .section + .section { margin-top: 0; }

  /* ── карточки услуг ── */
  .services { list-style: none; display: flex; flex-direction: column; gap: .75rem; }

  .service-card {
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    transition: transform .15s, box-shadow .15s;
  }
  .service-card:hover { transform: translateY(-2px); box-shadow: 0 6px 24px rgba(0,0,0,.1); }
  .service-name  { font-size: 1rem; font-weight: 500; }
  .service-price {
    white-space: nowrap;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--primary);
    background: #eff6ff;
    padding: .3rem .8rem;
    border-radius: 8px;
  }

  .empty-state {
    background: var(--surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 2.5rem;
    text-align: center;
    color: var(--muted);
  }

  /* ── подвал ── */
  .site-footer {
    text-align: center;
    color: var(--muted);
    font-size: .8rem;
    padding: 1.5rem 0 2rem;
  }

  @media (max-width: 480px) {
    .site-header h1 { font-size: 1.4rem; }
    .service-card   { flex-direction: column; align-items: flex-start; }
  }
</style>
