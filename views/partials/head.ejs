    border-radius: var(--radius);
    box-shadow: 0 4px 18px rgba(43, 56, 128, .08);
    padding: 0 0 .85rem;
    overflow: hidden;
    color: var(--text);
    transform-origin: center center;
    cursor: pointer;
    transition: box-shadow .3s ease;
  }
  .film-card-link {
    color: inherit;
    text-decoration: none;
    display: block;
  }
  .film-art {
    height: 132px;
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, #edf1ff 0%, #fafbff 55%, #f4edff 100%);
    box-shadow: inset 0 3px 0 var(--accent);
