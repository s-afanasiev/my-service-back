  }
  .service-brand-chip.is-sakura {
    background: #c5302d;
    border-color: #9f1d1c;
    padding: .2rem;
  }
  .service-brand-chip.is-sakura img { height: 52px; }
  .service-brand-chip.is-superfine {
    background: #fff;
    border-color: #9a1b1f;
  }
  .service-brand-chip.is-superfine img { height: 48px; }
  .service-brand-chip.is-gala {
    background: #fff;
    border-color: #8a6a3b;
  }
  .service-brand-chip.is-colortek {
    background: #fff;
    border-color: #c4122f;
  }
  .service-brand-chip.is-t2 {
    background: #fff;
    border-color: #d4a017;
  }
  .service-brand-chip.is-netproduct {
    background: #fff;
    border-color: #163a73;
    padding: .2rem;
  }
  .service-brand-chip.is-netproduct img { height: 52px; }
  .service-brand-banner {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 12px;
    padding: .65rem .75rem .7rem;
    box-shadow: 0 2px 10px rgba(43, 56, 128, .08);
  }
  .service-brand-banner.is-hiblack {
    background: #111;
