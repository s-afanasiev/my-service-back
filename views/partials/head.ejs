  .film-art img {
    width: 100%;
    height: 132px;
    object-fit: contain;
    background: transparent;
    mix-blend-mode: multiply;
  }
  .printer-svg { width: 148px; height: 94px; }
  .printer-lid { fill: #90a4c0; display: none; }
  .film-card.is-mfp .printer-lid { display: block; }
  .printer-body { fill: #fff; stroke: #c5d0dc; stroke-width: 2; }
  .printer-window { fill: #e2e8f0; }
  .printer-paper { fill: #fff; stroke: #cbd5e1; stroke-width: 1.2; }
  .printer-tray { fill: #d9e4f2; }
  .printer-dot { fill: var(--accent); }
  .printer-cmyk { display: none; }
  .printer-cmyk circle:nth-child(1) { fill: #22d3ee; }
  .printer-cmyk circle:nth-child(2) { fill: #e879f9; }
  .printer-cmyk circle:nth-child(3) { fill: #facc15; }
  .film-card.is-color .printer-cmyk { display: block; }

  .film-brand {
