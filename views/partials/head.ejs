    color: var(--muted);
  }
  .film-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: .85rem 1rem 0;
    padding-top: .65rem;
    border-top: 1px solid rgba(226, 232, 252, .85);
