  }
  .service-brand-banner.is-gala .service-brand-banner-text { color: #efe4d0; }
  .service-brand-banner.is-gala .service-brand-back { background: #8a6a3b; color: #fff; }
  .service-brand-banner.is-colortek {
    background: #0b1020;
