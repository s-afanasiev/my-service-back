<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg:          #f4f6fc;
    --surface:     rgba(255,255,255,.72);
    --surface-2:   rgba(255,255,255,.82);
    --glass-border:rgba(255,255,255,.7);
    --hairline:    rgba(148,163,203,.22);
    --primary:     #4c6ef5;
    --primary-dark:#3b55d9;
    --primary-soft:rgba(76,110,245,.1);
    --text:        #1d2438;
    --muted:       #68718a;
    --radius:      18px;
    --radius-lg:   26px;
    --shadow:      0 6px 28px rgba(43, 56, 128, .08);
    --shadow-lg:   0 22px 60px rgba(30, 42, 105, .18);
    --grad-main:   linear-gradient(120deg, #4c6ef5 0%, #7c5cf6 60%, #9d5cf0 100%);
    --grad-pill:   linear-gradient(135deg, #e9edff 0%, #f4edff 100%);
    --brand-hp:      #0277bd;
    --brand-canon:   #c62828;
    --brand-brother: #1565c0;
    --brand-xerox:   #d32f2f;
    --brand-samsung: #1a237e;
    --brand-pantum:  #c62828;
    --brand-katyusha: #b71c1c;
    --brand-kyocera: #e65100;
    --brand-epson:   #1565c0;
  }

  /* ── светлая база с мягкими градиентными пятнами ── */
  body {
    font-family: "Inter", sans-serif;
    color: var(--text);
    min-height: 100vh;
    background-color: var(--bg);
    background-image:
      radial-gradient(44rem 44rem at 6% -8%,  rgba(99, 130, 255, .16), transparent 62%),
      radial-gradient(40rem 40rem at 104% -4%, rgba(167, 139, 250, .15), transparent 62%),
      radial-gradient(52rem 46rem at 50% 118%, rgba(56, 189, 248, .12),  transparent 64%),
      radial-gradient(30rem 30rem at 82% 46%,  rgba(244, 214, 255, .12), transparent 60%);
    background-attachment: fixed;
  }

  body.modal-open { overflow: hidden; }

  ::selection { background: rgba(124, 92, 246, .22); }

  /* ── общий контейнер ── */
  .container {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* ── шапка: градиент + «жидкое стекло» ── */
  .site-header {
    position: relative;
    color: #fff;
    padding: 4.25rem 1.5rem 4.75rem;
    text-align: center;
    overflow: hidden;
    background: linear-gradient(135deg, #4a6bf4 0%, #6d5cf6 52%, #9a55f0 100%);
    border-radius: 0 0 34px 34px;
    box-shadow: 0 26px 70px rgba(80, 88, 220, .28);
  }

  /* Фото (если есть /hero-bg.jpg) — мягко тонировано градиентом */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: url('/hero-bg.jpg');
    background-size: cover;
    background-position: center;
    opacity: .26;
    mix-blend-mode: luminosity;
    z-index: 0;
  }

  /* Световые блики поверх градиента */
  .site-header::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(54rem 22rem at 12% -10%, rgba(255,255,255,.3), transparent 62%),
      radial-gradient(42rem 26rem at 94% 112%, rgba(56,189,248,.38), transparent 64%),
      radial-gradient(30rem 18rem at 82% -12%, rgba(186,148,255,.42), transparent 62%);
    z-index: 0;
    pointer-events: none;
  }

  .site-header > * { position: relative; z-index: 1; }

  .company-name {
    display: inline-block;
    padding: .42rem 1.05rem;
    border-radius: 999px;
    background: rgba(255,255,255,.14);
    border: 1px solid rgba(255,255,255,.32);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.28);
    font-size: .76rem;
    font-weight: 600;
    letter-spacing: .15em;
    text-transform: uppercase;
    margin-bottom: 1.1rem;
  }
  .site-header h1 {
    font-size: 2.4rem;
    font-weight: 800;
    letter-spacing: -1px;
    text-shadow: 0 2px 28px rgba(28, 38, 118, .4);
  }
  .site-header .lead {
    margin-top: .7rem;
    color: rgba(255,255,255,.93);
    font-size: 1.06rem;
    line-height: 1.55;
    max-width: 560px;
    margin-inline: auto;
    text-shadow: 0 1px 12px rgba(28, 38, 118, .3);
  }

  /* ── кнопки-контакты: стеклянные пилюли ── */
  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem;
    justify-content: center;
    margin-top: 1.75rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .6rem 1.25rem;
    border: 1px solid rgba(255,255,255,.38);
    border-radius: 999px;
    font-size: .9rem;
    font-weight: 600;
    text-decoration: none;
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    backdrop-filter: blur(10px) saturate(140%);
    box-shadow: 0 10px 26px rgba(15, 23, 42, .22), inset 0 1px 0 rgba(255,255,255,.35);
    transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
  }
  .btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.06);
    box-shadow: 0 14px 32px rgba(15, 23, 42, .26), inset 0 1px 0 rgba(255,255,255,.4);
  }

  /* ── блоки страницы ── */
  .section {
    margin: 2.25rem auto 2.5rem;
    padding: 0 1rem;
    max-width: 980px;
  }
  .section + .section { margin-top: 0; }

  /* ── bento-панель услуг ── */
  .services {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: .8rem;
    background: var(--surface);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow), inset 0 1px 0 rgba(255,255,255,.85);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    backdrop-filter: blur(18px) saturate(150%);
    padding: 1.05rem;
  }

  .service-card {
    background: var(--surface-2);
    border: 1px solid rgba(226, 232, 252, .9);
    border-radius: 16px;
    box-shadow: 0 2px 10px rgba(43, 56, 128, .05);
    padding: 1.15rem 1.3rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease;
    cursor: pointer;
    color: inherit;
    text-decoration: none;
  }
  .service-card:hover {
    transform: translateY(-2px);
    border-color: rgba(76, 110, 245, .38);
    box-shadow: 0 12px 30px rgba(60, 80, 190, .14);
  }
  .service-card:focus { outline: none; }
  .service-card:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
  .service-name  { font-size: 1rem; font-weight: 600; letter-spacing: -.2px; }
  .service-price {
    white-space: nowrap;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--primary-dark);
    background: var(--grad-pill);
    border: 1px solid rgba(76, 110, 245, .16);
    padding: .32rem .85rem;
    border-radius: 999px;
    box-shadow: inset 0 1px 0 rgba(255,255,255,.8);
  }

  .service-svg { width: 148px; height: 94px; }
  .service-svg .svc-bg { fill: #e9edfb; }

  .service-modal {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-items: center;
    padding: 2vh 1rem;
  }
  .service-modal[hidden] { display: none !important; }
  .service-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(23, 31, 68, .4);
    -webkit-backdrop-filter: blur(14px) saturate(130%);
    backdrop-filter: blur(14px) saturate(130%);
  }
  .service-modal-dialog {
    position: relative;
    z-index: 1;
    width: 70vw;
    height: 90vh;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: rgba(255,255,255,.86);
    -webkit-backdrop-filter: blur(26px) saturate(160%);
    backdrop-filter: blur(26px) saturate(160%);
    border: 1px solid rgba(255,255,255,.8);
    border-radius: 24px;
    box-shadow: var(--shadow-lg);
    padding: 1.15rem 1.35rem 1.1rem;
  }
  .service-modal-dialog:focus { outline: none; }
  .service-modal-close {
    position: absolute;
    top: .65rem;
    left: .65rem;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(226, 232, 252, .9);
    border-radius: 50%;
    background: rgba(255,255,255,.8);
    color: #334155;
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
    z-index: 2;
    box-shadow: 0 4px 14px rgba(43, 56, 128, .12);
    transition: background .15s ease, transform .15s ease;
  }
  .service-modal-close:hover { background: #fff; transform: rotate(90deg); }
  .service-modal-hero {
    flex: 0 0 400px;
    height: 400px;
    min-height: 0;
    min-width: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .65rem;
    margin: 0 0 .7rem;
  }
  .service-modal-hero.is-photo-only { grid-template-columns: 1fr; }
  .service-modal-side {
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: rgba(243, 246, 253, .9);
    border: 1px solid rgba(226, 232, 252, .8);
    border-radius: 14px;
    padding: .7rem .75rem .75rem;
  }
  .service-modal-side[hidden] { display: none !important; }
  .service-brand-caption {
    flex: 0 0 auto;
    margin: 0 0 .5rem .05rem;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .service-brand-list {
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    align-items: flex-start;
    gap: .5rem;
    overflow: auto;
    min-height: 0;
  }
  .service-brand-chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    height: 60px;
    max-width: 100%;
    padding: .35rem .75rem;
    border: 1px solid transparent;
    border-radius: 12px;
    background: #fff;
    color: var(--text);
    box-shadow: 0 2px 8px rgba(43, 56, 128, .08);
    font-family: inherit;
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: -.1px;
    line-height: 1;
    cursor: pointer;
    white-space: nowrap;
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .service-brand-chip img {
    display: block;
    height: 44px;
    width: auto;
    max-width: 240px;
    object-fit: contain;
    background: #fff;
  }
  .service-brand-chip.is-hiblack img,
  .service-brand-chip.is-sakura img {
    background: transparent;
  }
  .service-brand-chip img + span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .service-brand-chip:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(43, 56, 128, .16); }
  .service-brand-chip:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
  .service-brand-chip.is-hiblack {
    background: #ffd400;
    border-color: #111;
    color: #111;
  }
  .service-brand-chip.is-nvprint {
    background: #fff;
    border-color: #0b1f3a;
  }
  .service-brand-chip.is-7quality {
    background: #fff;
    border-color: #e30613;
  }
  .service-brand-chip.is-7quality img { height: 52px; }
  .service-brand-chip.is-cactus {
