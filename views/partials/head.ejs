  }
  .service-brand-banner.is-colouring .service-brand-back { background: #ec1c24; color: #fff; }
  .service-brand-banner.is-sakura {
    background: #c5302d;
    color: #fff;
  }
  .service-brand-banner.is-sakura .service-brand-banner-text { color: #fff7f7; }
  .service-brand-banner.is-sakura .service-brand-back { background: #fff; color: #c5302d; }
  .service-brand-banner.is-sakura .service-brand-banner-logo { height: 36px; }
  .service-brand-banner.is-superfine {
    background: #140809;
    color: #fff;
  }
  .service-brand-banner.is-superfine .service-brand-banner-text { color: #f3d5d6; }
  .service-brand-banner.is-superfine .service-brand-back { background: #9a1b1f; color: #fff; }
  .service-brand-banner.is-gala {
