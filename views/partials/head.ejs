    min-width: 118px;
  }
  .service-brand-chip.is-sakura {
    background: #c5302d;
    border-color: #9f1d1c;
    min-width: 42px;
    height: 42px;
    padding: .15rem;
  }
  .service-brand-chip.is-sakura img { height: 34px; }
  .service-brand-chip.is-superfine {
    background: #111;
    border-color: #9a1b1f;
    min-width: 128px;
    height: 40px;
  }
  .service-brand-chip.is-superfine img { height: 32px; }
  .service-brand-chip.is-gala {
    background: #111;
    border-color: #8a6a3b;
    min-width: 108px;
  }
  .service-brand-chip.is-colortek {
    background: #111;
    border-color: #c4122f;
    min-width: 124px;
    height: 40px;
  }
  .service-brand-chip.is-colortek img { height: 28px; }
  .service-brand-chip.is-t2 {
    background: #111;
    border-color: #d4a017;
    min-width: 72px;
  }
  .service-brand-chip.is-netproduct {
    background: #163a73;
    border-color: #0f2a54;
    min-width: 42px;
    height: 42px;
    padding: .12rem;
  }
  .service-brand-chip.is-netproduct img { height: 36px; }
  .service-brand-banner {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 10px;
    padding: .65rem .75rem .7rem;
    box-shadow: 0 1px 8px rgba(15, 23, 42, .08);
  }
  .service-brand-banner.is-hiblack {
    background: #111;
    color: #ffd400;
  }
  .service-brand-banner.is-hiblack .service-brand-banner-text { color: #f4f4f5; }
  .service-brand-banner.is-hiblack .service-brand-back { background: #ffd400; color: #111; }
  .service-brand-banner.is-hiblack .service-brand-banner-logo { display: none; }
  .service-brand-banner.is-nvprint {
    background: #071427;
