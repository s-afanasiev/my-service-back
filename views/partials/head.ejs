  }
  .service-brand-banner.is-nvprint .service-brand-banner-text { color: #e2e8f0; }
  .service-brand-banner.is-nvprint .service-brand-back { background: #1e4d8c; color: #fff; }
  .service-brand-banner.is-7quality {
    background: #fff;
    box-shadow: inset 0 4px 0 #e30613, 0 1px 8px rgba(15, 23, 42, .08);
  }
  .service-brand-banner.is-7quality .service-brand-back { background: #e30613; color: #fff; }
  .service-brand-banner.is-cactus {
    background: #111;
