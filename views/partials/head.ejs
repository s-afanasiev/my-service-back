  }
  .service-brand-banner.is-cactus .service-brand-banner-text { color: #e8f5c8; }
  .service-brand-banner.is-cactus .service-brand-back { background: #b6e31a; color: #111; }
  .service-brand-banner.is-easyprint {
    background: #7a1218;
    color: #fff;
    box-shadow: inset 0 4px 0 #f48024, 0 1px 8px rgba(15, 23, 42, .08);
  }
  .service-brand-banner.is-easyprint .service-brand-banner-text { color: #fde8e8; }
  .service-brand-banner.is-easyprint .service-brand-back { background: #f48024; color: #fff; }
