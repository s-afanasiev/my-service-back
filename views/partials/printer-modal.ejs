<%# Общая модалка принтера (docs/ui-carousel-modal.md).
    Переиспользуется в карусели главной (partials/featured-printers.ejs) и каталоге /modeli.
    Управление и заполнение — partials/printer-modal-js.ejs (window.PrinterModal). %>
<div class="printer-modal" data-printer-modal hidden>
  <div class="printer-modal-backdrop" data-modal-close></div>
  <button type="button" class="printer-modal-nav is-prev" data-modal-dir="-1" aria-label="Предыдущий принтер">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 4 7 12l8 8" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <div class="printer-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="printer-modal-title">
    <button type="button" class="printer-modal-close" data-modal-close aria-label="Закрыть">×</button>
    <div class="printer-modal-photo" data-modal-photo></div>
    <p class="printer-modal-brand" data-modal-brand></p>
    <h3 id="printer-modal-title" data-modal-title></h3>
    <div class="printer-modal-desc-block">
      <h4>Описание</h4>
      <p class="printer-modal-desc" data-modal-desc></p>
    </div>
    <div class="printer-modal-specs-block">
      <h4>Характеристики</h4>
      <div class="printer-modal-specs-scroll" data-modal-scroll>
        <table class="printer-modal-table">
          <tbody data-modal-specs></tbody>
        </table>
      </div>
    </div>
    <div class="modal-actions">
      <div class="modal-actions-left">
        <span class="printer-modal-price" data-modal-price hidden></span>
        <a class="modal-page-link" data-modal-page href="/">Страница модели →</a>
        <a class="modal-page-link modal-analog-link" data-modal-analog hidden href="#">Аналог дешевле →</a>
      </div>
      <% if (typeof contacts !== "undefined" && contacts && contacts.length) { %>
        <div class="modal-contacts">
          <% contacts.forEach(function(c) { %>
            <a class="btn modal-contact-btn"
               href="<%= c.url %>"
               style="background: <%= c.color %>; color: <%= c.textColor %>;"
               <% if (!c.url.startsWith("tel:") && !c.url.startsWith("mailto:")) { %>target="_blank" rel="noopener"<% } %>>
              <%= c.type %>
            </a>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>
  <button type="button" class="printer-modal-nav is-next" data-modal-dir="1" aria-label="Следующий принтер">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 4 8 8-8 8" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</div>
