<header class="page-top">
  <a class="page-top-brand" href="/"><%= siteName || "Заправка-Курск" %></a>
  <nav class="page-top-nav" aria-label="Разделы">
    <button type="button" class="quick-search-btn" data-qs-open aria-keyshortcuts="Control+K">🔍 Поиск</button>
    <a href="/#uslugi">Услуги и цены</a>
    <a href="/modeli">Каталог моделей</a>
    <a href="/kartridzhi">Картриджи</a>
    <a href="/stati">Статьи</a>
  </nav>
  <% if (contacts && contacts.length > 0) { %>
    <nav class="contacts" aria-label="Контакты">
      <button type="button" class="btn btn-lead" data-lead-open data-lead-context="Заявка с сайта">Написать заявку</button>
      <% contacts.forEach(function(c) { %>
        <a class="btn"
           href="<%= c.url %>"
           style="background: <%= c.color %>; color: <%= c.textColor %>;"
           <% if (!c.url.startsWith("tel:") && !c.url.startsWith("mailto:")) { %>target="_blank" rel="noopener"<% } %>>
          <%= c.type %>
        </a>
      <% }); %>
    </nav>
  <% } %>
</header>
