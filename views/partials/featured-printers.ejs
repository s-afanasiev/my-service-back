<% if (featured && featured.length) { %>
<section class="featured" aria-label="Популярные модели">
  <div class="featured-head">
    <h2>Популярные модели</h2>
    <p>Часто заправляем и ремонтируем эти модели в Курске · <a class="featured-all" href="/modeli">Весь каталог моделей</a></p>
  </div>

  <div class="filmstrip" data-filmstrip>
    <button class="filmstrip-btn" type="button" data-dir="-1" aria-label="Предыдущая модель">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5 8 12l7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <div class="filmstrip-stage" tabindex="0" aria-roledescription="карусель">
      <ul class="filmstrip-track">
        <% featured.forEach(function(p, i) { %>
          <li class="film-card<%= p.device_type === 'mfp' ? ' is-mfp' : '' %><%= p.color_mode === 'color' ? ' is-color' : '' %><%= p.print_technology === 'inkjet' ? ' is-inkjet' : '' %>"
              data-brand="<%= p.brandSlug %>"
              data-index="<%= i %>"
              data-page="/modeli/<%= p.slug %>"
              data-analog-url="<%= p.analogUrl || '' %>"
              data-analog-label="<%= p.analogLabel || '' %>"
              style="--accent: var(--brand-<%= p.brandSlug %>, var(--primary))">
            <a class="film-card-link" href="/modeli/<%= p.slug %>">
            <div class="film-art" aria-hidden="true">
              <% if (p.imageUrl) { %>
                <img src="<%= p.imageUrl %>" alt="<%= p.brand %> <%= p.model %>" width="240" height="150" loading="lazy" decoding="async" />
              <% } else { %>
                <svg class="printer-svg" viewBox="0 0 200 128" fill="none">
                  <rect class="printer-lid" x="38" y="10" width="124" height="18" rx="4" />
                  <rect class="printer-body" x="28" y="32" width="144" height="72" rx="10" />
                  <rect class="printer-window" x="46" y="44" width="108" height="36" rx="4" />
                  <rect class="printer-paper" x="58" y="50" width="84" height="24" rx="2" />
                  <rect class="printer-tray" x="40" y="96" width="120" height="10" rx="3" />
                  <circle class="printer-dot" cx="48" cy="88" r="3.5" />
                  <g class="printer-cmyk">
                    <circle cx="148" cy="88" r="3.5" /><circle cx="158" cy="88" r="3.5" /><circle cx="168" cy="88" r="3.5" />
                  </g>
                </svg>
              <% } %>
            </div>
            <p class="film-brand"><%= p.brand %></p>
            <h3 class="film-model"><%= p.model %></h3>
            <p class="film-meta"><%= p.meta %></p>
            <div class="film-foot">
              <span><%= String(i + 1).padStart(2, '0') %></span>
              <span><%= p.typeLabel %></span>
            </div>
            </a>
            <span class="film-type" hidden><%= p.typeLabel %></span>
            <span class="film-tech" hidden><%= p.techLabel %></span>
            <span class="film-color" hidden><%= p.colorLabel %></span>
            <p class="film-desc" hidden><%= p.description %></p>
            <script type="application/json" class="film-specs"><%- JSON.stringify(p.specRows || []).replace(/</g, '\\u003c') %></script>
          </li>
        <% }); %>
      </ul>
    </div>

    <button class="filmstrip-btn" type="button" data-dir="1" aria-label="Следующая модель">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <div class="filmstrip-dots" role="group" aria-label="Модели">
      <button type="button" class="filmstrip-pause" data-pause aria-pressed="false" aria-label="Остановить автопрокрутку">⏸ Пауза</button>
      <% featured.forEach(function(p, i) { %>
        <button type="button" class="filmstrip-dot<%= i === 0 ? ' is-on' : '' %>" data-go="<%= i %>" aria-label="<%= p.brand %> <%= p.model %>"></button>
      <% }); %>
    </div>
    <p class="filmstrip-live" data-live aria-live="polite"></p>
  </div>
</section>

<%- include('printer-modal') %>
<%- include('printer-modal-js') %>
<script>
(function () {
  var root = document.querySelector("[data-filmstrip]");
  if (!root) return;

  var cards = [].slice.call(root.querySelectorAll(".film-card"));
  var dots  = [].slice.call(root.querySelectorAll(".filmstrip-dot"));
  var live  = root.querySelector("[data-live]");
  var stage = root.querySelector(".filmstrip-stage");
  var n = cards.length;
  if (!n) return;
  if (!window.PrinterModal) return;

  var active = 0;
  var timer = null;
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var use3d = !reduce && n > 2;

  function wrapDelta(i) {
    var d = i - active;
    var half = n / 2;
    if (d > half) d -= n;
    if (d < -half) d += n;
    return d;
  }

  function announce() {
    if (!live) return;
    var title = cards[active].querySelector(".film-brand").textContent
      + " " + cards[active].querySelector(".film-model").textContent;
    live.textContent = "Модель " + (active + 1) + " из " + n + ": " + title;
  }

  function layout(userAction) {
    dots.forEach(function (dot, i) {
      dot.classList.toggle("is-on", i === active);
    });
    cards.forEach(function (card, i) {
      card.classList.toggle("is-center", i === active);
      if (!use3d) return;
      var d = wrapDelta(i);
      var step = window.innerWidth < 640 ? 118 : 152;
      var tilt = window.innerWidth < 640 ? 22 : 30;
      var abs = d < 0 ? -d : d;
      card.style.transform =
        "translate(-50%, -50%) translateX(" + (d * step) + "px) translateZ(" + (-abs * 72) + "px) rotateY(" + (d * -tilt) + "deg) scale(" + (d === 0 ? 1.05 : 1 - abs * 0.08) + ")";
      card.style.opacity = abs > 2 ? "0" : (abs === 2 ? "0.42" : "1");
      card.style.zIndex = String(10 - abs);
      card.style.pointerEvents = abs > 2 ? "none" : "auto";
    });
    if (!use3d) {
      cards[active].scrollIntoView({ inline: "center", block: "nearest", behavior: reduce ? "auto" : "smooth" });
    }
    // aria-live озвучиваем только по действию пользователя (задача 8.1)
    if (userAction !== false) announce();
  }

  function go(i, userAction) {
    active = (i % n + n) % n;
    layout(userAction);
  }

  // ── автопрокрутка: пауза и стоп после первого взаимодействия (задача 8.1) ──
  var pauseBtn = root.querySelector("[data-pause]");
  var userPaused = false;
  try {
    userPaused = window.localStorage && localStorage.getItem("carousel-autoplay") === "off";
  } catch (err) {}
  var interacted = false;

  function syncPause() {
    if (!pauseBtn) return;
    var paused = userPaused || interacted;
    pauseBtn.setAttribute("aria-pressed", paused ? "true" : "false");
    pauseBtn.setAttribute("aria-label", paused ? "Возобновить автопрокрутку" : "Остановить автопрокрутку");
    pauseBtn.textContent = paused ? "▶ Старт" : "⏸ Пауза";
  }

  function markInteract() {
    interacted = true;
    stopIdle();
    syncPause();
  }

  function stopIdle() {
    if (timer) { clearInterval(timer); timer = null; }
  }

  function startIdle() {
    stopIdle();
    if (reduce || n < 2) return;
    if (userPaused || interacted) return;
    if (document.body.classList.contains("modal-open")) return;
    timer = setInterval(function () { go(active + 1, false); }, 4500);
  }

  if (pauseBtn) {
    pauseBtn.addEventListener("click", function () {
      if (userPaused || interacted) {
        userPaused = false;
        interacted = false;
        try { localStorage.setItem("carousel-autoplay", "on"); } catch (err) {}
        startIdle();
      } else {
        userPaused = true;
        stopIdle();
        try { localStorage.setItem("carousel-autoplay", "off"); } catch (err) {}
      }
      syncPause();
    });
  }
  syncPause();

  function textOf(el, sel) {
    var node = el.querySelector(sel);
    return node ? node.textContent.replace(/^\s+|\s+$/g, "") : "";
  }

  function specsOf(card) {
    var specNode = card.querySelector(".film-specs");
    if (!specNode) return [];
    try { return JSON.parse(specNode.textContent) || []; } catch (err) { return []; }
  }

  function openModal(card, keepFocus) {
    if (!window.PrinterModal) return;
    stopIdle();
    var photoNode = null;
    var srcImg = card.querySelector(".film-art img");
    if (srcImg) {
      photoNode = srcImg.cloneNode(true);
      photoNode.removeAttribute("width");
      photoNode.removeAttribute("height");
    } else {
      var srcArt = card.querySelector(".film-art");
      if (srcArt) photoNode = srcArt.cloneNode(true);
    }
    PrinterModal.open({
      photoNode: photoNode,
      brand: textOf(card, ".film-brand"),
      model: textOf(card, ".film-model"),
      description: textOf(card, ".film-desc"),
      specRows: specsOf(card),
      accent: getComputedStyle(card).getPropertyValue("--accent"),
      pageUrl: card.getAttribute("data-page") || "/",
      analogUrl: card.getAttribute("data-analog-url") || "",
      analogLabel: card.getAttribute("data-analog-label") || "",
      keepFocus: !!keepFocus
    });
  }

  function stepModal(dir) {
    go(active + dir);
    openModal(cards[active], true);
  }

  function closeModal() {
    if (!window.PrinterModal || !PrinterModal.isOpen()) return;
    PrinterModal.close();
    startIdle();
  }

  if (use3d) root.classList.add("is-3d");

  root.querySelectorAll("[data-dir]").forEach(function (btn) {
    btn.addEventListener("click", function () { markInteract(); go(active + Number(btn.getAttribute("data-dir"))); startIdle(); });
  });
  dots.forEach(function (dot) {
    dot.addEventListener("click", function () { markInteract(); go(Number(dot.getAttribute("data-go"))); startIdle(); });
  });

  stage.addEventListener("keydown", function (e) {
    if (e.key === "ArrowRight") { e.preventDefault(); markInteract(); go(active + 1); startIdle(); }
    if (e.key === "ArrowLeft")  { e.preventDefault(); markInteract(); go(active - 1); startIdle(); }
  });

  var startX = 0, dragging = false;
  function cardAtClientX(clientX) {
    var rect = stage.getBoundingClientRect();
    var x = clientX - (rect.left + rect.width / 2);
    var step = window.innerWidth < 640 ? 118 : 152;
    var bestI = active;
    var bestD = Infinity;
    for (var i = 0; i < n; i++) {
      var off = wrapDelta(i);
      if (Math.abs(off) > 2) continue;
      var dist = Math.abs(x - off * step);
      if (dist < bestD) { bestD = dist; bestI = i; }
    }
    return cards[bestI];
  }
  stage.addEventListener("pointerdown", function (e) {
    if (e.button && e.button !== 0) return;
    dragging = true;
    startX = e.clientX;
    try { stage.setPointerCapture(e.pointerId); } catch (err) {}
    markInteract();
    stopIdle();
  });
  stage.addEventListener("pointerup", function (e) {
    if (!dragging) return;
    dragging = false;
    var dx = e.clientX - startX;
    if (dx > 70) { go(active - 1); startIdle(); }
    else if (dx < -70) { go(active + 1); startIdle(); }
    else {
      var card = cardAtClientX(e.clientX);
      var i = Number(card.getAttribute("data-index"));
      if (i !== active) go(i);
      openModal(cards[active]);
    }
  });
  stage.addEventListener("pointercancel", function () {
    dragging = false;
    startIdle();
  });

  var wheelLock = 0;
  var wheelAcc = 0;
  root.addEventListener("wheel", function (e) {
    if (window.PrinterModal && PrinterModal.isOpen()) return;
    var dx = e.deltaX;
    var dy = e.deltaY;
    var isHorizontal = Math.abs(dx) > Math.abs(dy) || e.shiftKey;
    if (!isHorizontal) return;
    var delta = Math.abs(dx) > Math.abs(dy) ? dx : dy;
    if (!delta) return;
    e.preventDefault();
    var now = Date.now();
    if (now < wheelLock) return;
    wheelAcc += delta;
    if (Math.abs(wheelAcc) < 40) return;
    var dir = wheelAcc > 0 ? 1 : -1;
    wheelAcc = 0;
    wheelLock = now + 420;
    markInteract();
    go(active + dir);
    startIdle();
  }, { passive: false });

  root.addEventListener("mouseenter", stopIdle);
  root.addEventListener("mouseleave", startIdle);

  if ("IntersectionObserver" in window) {
    var seen = new IntersectionObserver(function (entries) {
      if (entries[0].isIntersecting) startIdle();
      else stopIdle();
    }, { threshold: 0.25 });
    seen.observe(root);
  } else {
    startIdle();
  }

  document.addEventListener("visibilitychange", function () {
    if (document.hidden) stopIdle();
    else startIdle();
  });

  window.addEventListener("resize", function () {
    if (use3d) layout();
  });

  PrinterModal.init({
    onStep: function (dir) { markInteract(); stepModal(dir); },
    onClose: function () { startIdle(); }
  });
  if (n < 2) PrinterModal.setNav(false);

  layout();

  // Задача 6.1: клик и Enter на карточке открывают модалку (модификаторы — честный переход)
  cards.forEach(function (card) {
    var link = card.querySelector(".film-card-link");
    if (!link) return;
    link.addEventListener("click", function (e) {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button) return;
      e.preventDefault();
      if (window.PrinterModal && PrinterModal.isOpen()) return;
      markInteract();
      openModal(card);
    });
  });
})();
</script>
<% } %>
