<% if (featured && featured.length) { %>
<section class="featured" aria-label="Популярные модели">
  <div class="featured-head">
    <h2>Популярные модели</h2>
    <p>Часто заправляем и ремонтируем эти модели в Курске</p>
  </div>

  <div class="filmstrip" data-filmstrip>
    <button class="filmstrip-btn" type="button" data-dir="-1" aria-label="Предыдущая модель">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5 8 12l7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <div class="filmstrip-stage" tabindex="0" aria-roledescription="карусель">
      <ul class="filmstrip-track">
        <% featured.forEach(function(p, i) { %>
          <li class="film-card<%= p.device_type === 'mfp' ? ' is-mfp' : '' %><%= p.color_mode === 'color' ? ' is-color' : '' %><%= p.print_technology === 'inkjet' ? ' is-inkjet' : '' %>"
              data-brand="<%= p.brandSlug %>"
              data-index="<%= i %>"
              style="--accent: var(--brand-<%= p.brandSlug %>, var(--primary))">
            <div class="film-art" aria-hidden="true">
              <% if (p.imageUrl) { %>
                <img src="<%= p.imageUrl %>" alt="" width="240" height="150" loading="lazy" decoding="async" />
              <% } else { %>
                <svg class="printer-svg" viewBox="0 0 200 128" fill="none">
                  <rect class="printer-lid" x="38" y="10" width="124" height="18" rx="4" />
                  <rect class="printer-body" x="28" y="32" width="144" height="72" rx="10" />
                  <rect class="printer-window" x="46" y="44" width="108" height="36" rx="4" />
                  <rect class="printer-paper" x="58" y="50" width="84" height="24" rx="2" />
                  <rect class="printer-tray" x="40" y="96" width="120" height="10" rx="3" />
                  <circle class="printer-dot" cx="48" cy="88" r="3.5" />
                  <g class="printer-cmyk">
                    <circle cx="148" cy="88" r="3.5" /><circle cx="158" cy="88" r="3.5" /><circle cx="168" cy="88" r="3.5" />
                  </g>
                </svg>
              <% } %>
            </div>
            <p class="film-brand"><%= p.brand %></p>
            <h3 class="film-model"><%= p.model %></h3>
            <p class="film-meta"><%= p.meta %></p>
            <div class="film-foot">
              <span><%= String(i + 1).padStart(2, '0') %></span>
              <span><%= p.typeLabel %></span>
            </div>
            <span class="film-type" hidden><%= p.typeLabel %></span>
            <span class="film-tech" hidden><%= p.techLabel %></span>
            <span class="film-color" hidden><%= p.colorLabel %></span>
            <p class="film-desc" hidden><%= p.description %></p>
          </li>
        <% }); %>
      </ul>
    </div>

    <button class="filmstrip-btn" type="button" data-dir="1" aria-label="Следующая модель">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <div class="filmstrip-dots" role="group" aria-label="Модели">
      <% featured.forEach(function(p, i) { %>
        <button type="button" class="filmstrip-dot<%= i === 0 ? ' is-on' : '' %>" data-go="<%= i %>" aria-label="<%= p.brand %> <%= p.model %>"></button>
      <% }); %>
    </div>
    <p class="filmstrip-live" data-live aria-live="polite"></p>
  </div>
</section>

<div class="printer-modal" data-printer-modal hidden>
  <div class="printer-modal-backdrop" data-modal-close></div>
  <div class="printer-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="printer-modal-title">
    <button type="button" class="printer-modal-close" data-modal-close aria-label="Закрыть">×</button>
    <div class="printer-modal-photo" data-modal-photo></div>
    <p class="printer-modal-brand" data-modal-brand></p>
    <h3 id="printer-modal-title" data-modal-title></h3>
    <dl class="printer-modal-specs">
      <div><dt>Тип</dt><dd data-modal-type></dd></div>
      <div><dt>Печать</dt><dd data-modal-tech></dd></div>
      <div><dt>Цвет</dt><dd data-modal-color></dd></div>
    </dl>
    <p class="printer-modal-desc" data-modal-desc></p>
  </div>
</div>
<script>
(function () {
  var root = document.querySelector("[data-filmstrip]");
  if (!root) return;

  var cards = [].slice.call(root.querySelectorAll(".film-card"));
  var dots  = [].slice.call(root.querySelectorAll(".filmstrip-dot"));
  var live  = root.querySelector("[data-live]");
  var stage = root.querySelector(".filmstrip-stage");
  var modal = document.querySelector("[data-printer-modal]");
  var n = cards.length;
  if (!n) return;

  var active = 0;
  var timer = null;
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var use3d = !reduce && n > 2;

  function wrapDelta(i) {
    var d = i - active;
    var half = n / 2;
    if (d > half) d -= n;
    if (d < -half) d += n;
    return d;
  }

  function announce() {
    if (!live) return;
    var title = cards[active].querySelector(".film-brand").textContent
      + " " + cards[active].querySelector(".film-model").textContent;
    live.textContent = "Модель " + (active + 1) + " из " + n + ": " + title;
  }

  function layout() {
    dots.forEach(function (dot, i) {
      dot.classList.toggle("is-on", i === active);
    });
    cards.forEach(function (card, i) {
      card.classList.toggle("is-center", i === active);
      if (!use3d) return;
      var d = wrapDelta(i);
      var step = window.innerWidth < 640 ? 118 : 152;
      var tilt = window.innerWidth < 640 ? 22 : 30;
      var abs = d < 0 ? -d : d;
      card.style.transform =
        "translate(-50%, -50%) translateX(" + (d * step) + "px) translateZ(" + (-abs * 72) + "px) rotateY(" + (d * -tilt) + "deg) scale(" + (d === 0 ? 1.05 : 1 - abs * 0.08) + ")";
      card.style.opacity = abs > 2 ? "0" : (abs === 2 ? "0.42" : "1");
      card.style.zIndex = String(10 - abs);
      card.style.pointerEvents = abs > 2 ? "none" : "auto";
    });
    if (!use3d) {
      cards[active].scrollIntoView({ inline: "center", block: "nearest", behavior: reduce ? "auto" : "smooth" });
    }
    announce();
  }

  function go(i) {
    active = (i % n + n) % n;
    layout();
  }

  function stopIdle() {
    if (timer) { clearInterval(timer); timer = null; }
  }

  function startIdle() {
    stopIdle();
    if (reduce || n < 2) return;
    if (modal && !modal.hidden) return;
    timer = setInterval(function () { go(active + 1); }, 4500);
  }

  function textOf(el, sel) {
    var node = el.querySelector(sel);
    return node ? node.textContent.replace(/^\s+|\s+$/g, "") : "";
  }

  function openModal(card) {
    if (!modal) return;
    stopIdle();
    var photo = modal.querySelector("[data-modal-photo]");
    var art = card.querySelector(".film-art");
    photo.innerHTML = "";
    if (art) photo.appendChild(art.cloneNode(true));
    modal.querySelector("[data-modal-brand]").textContent = textOf(card, ".film-brand");
    modal.querySelector("[data-modal-title]").textContent = textOf(card, ".film-model");
    modal.querySelector("[data-modal-type]").textContent = textOf(card, ".film-type");
    modal.querySelector("[data-modal-tech]").textContent = textOf(card, ".film-tech");
    modal.querySelector("[data-modal-color]").textContent = textOf(card, ".film-color");
    modal.querySelector("[data-modal-desc]").textContent = textOf(card, ".film-desc");
    modal.style.setProperty("--accent", getComputedStyle(card).getPropertyValue("--accent"));
    modal.hidden = false;
    document.body.classList.add("modal-open");
    var closeBtn = modal.querySelector(".printer-modal-close");
    if (closeBtn) closeBtn.focus();
  }

  function closeModal() {
    if (!modal || modal.hidden) return;
    modal.hidden = true;
    document.body.classList.remove("modal-open");
    startIdle();
  }

  if (use3d) root.classList.add("is-3d");

  root.querySelectorAll("[data-dir]").forEach(function (btn) {
    btn.addEventListener("click", function () { go(active + Number(btn.getAttribute("data-dir"))); startIdle(); });
  });
  dots.forEach(function (dot) {
    dot.addEventListener("click", function () { go(Number(dot.getAttribute("data-go"))); startIdle(); });
  });
  cards.forEach(function (card) {
    card.addEventListener("click", function () {
      if (moved) return;
      var i = Number(card.getAttribute("data-index"));
      if (i !== active) go(i);
      openModal(card);
    });
  });

  stage.addEventListener("keydown", function (e) {
    if (e.key === "ArrowRight") { e.preventDefault(); go(active + 1); startIdle(); }
    if (e.key === "ArrowLeft")  { e.preventDefault(); go(active - 1); startIdle(); }
  });

  var startX = 0, dragging = false, moved = false;
  stage.addEventListener("pointerdown", function (e) {
    dragging = true; moved = false; startX = e.clientX;
    try { stage.setPointerCapture(e.pointerId); } catch (err) {}
    stopIdle();
  });
  stage.addEventListener("pointermove", function (e) {
    if (!dragging) return;
    if (Math.abs(e.clientX - startX) > 12) moved = true;
  });
  stage.addEventListener("pointerup", function (e) {
    if (!dragging) return;
    dragging = false;
    var dx = e.clientX - startX;
    if (dx > 40) go(active - 1);
    else if (dx < -40) go(active + 1);
    startIdle();
  });

  var wheelLock = 0;
  var wheelAcc = 0;
  root.addEventListener("wheel", function (e) {
    if (modal && !modal.hidden) return;
    var dx = e.deltaX;
    var dy = e.deltaY;
    var delta = Math.abs(dx) > Math.abs(dy) ? dx : dy;
    if (!delta) return;
    e.preventDefault();
    var now = Date.now();
    if (now < wheelLock) return;
    wheelAcc += delta;
    if (Math.abs(wheelAcc) < 40) return;
    var dir = wheelAcc > 0 ? 1 : -1;
    wheelAcc = 0;
    wheelLock = now + 420;
    go(active + dir);
    startIdle();
  }, { passive: false });

  root.addEventListener("mouseenter", stopIdle);
  root.addEventListener("mouseleave", startIdle);

  if ("IntersectionObserver" in window) {
    var seen = new IntersectionObserver(function (entries) {
      if (entries[0].isIntersecting) startIdle();
      else stopIdle();
    }, { threshold: 0.25 });
    seen.observe(root);
  } else {
    startIdle();
  }

  document.addEventListener("visibilitychange", function () {
    if (document.hidden) stopIdle();
    else startIdle();
  });

  window.addEventListener("resize", function () {
    if (use3d) layout();
  });

  if (modal) {
    modal.querySelectorAll("[data-modal-close]").forEach(function (el) {
      el.addEventListener("click", closeModal);
    });
  }
  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") closeModal();
  });

  layout();
})();
</script>
<% } %>
