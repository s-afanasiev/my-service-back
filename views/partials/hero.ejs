<header class="site-header">
  <p class="company-name"><%= siteName || 'Заправка-Курск' %></p>
  <nav class="hero-nav page-top-nav" aria-label="Разделы">
    <button type="button" class="quick-search-btn" data-qs-open aria-keyshortcuts="Control+K">🔍 Поиск</button>
    <a href="/#uslugi">Услуги и цены</a>
    <a href="/modeli">Каталог моделей</a>
    <a href="/kartridzhi">Картриджи</a>
    <a href="/stati">Статьи</a>
  </nav>
  <h1><%= heading %></h1>
  <p class="lead"><%= subheading %></p>

  <div class="hero-facts" aria-label="Преимущества">
    <a class="hero-fact" href="#kak-rabotaem">Выезд в день обращения</a>
    <a class="hero-fact" href="#kak-rabotaem">Гарантия на работы</a>
    <a class="hero-fact" href="/modeli">Каталог <%= typeof models !== "undefined" && models && models.length ? models.length : "50+" %> моделей →</a>
  </div>

  <% if (contacts.length > 0) { %>
    <nav class="contacts" aria-label="Контакты">
      <button type="button" class="btn btn-lead" data-lead-open data-lead-context="Заявка с главной страницы">Написать заявку</button>
      <% contacts.forEach(function(c) { %>
        <a class="btn"
           href="<%= c.url %>"
           style="background: <%= c.color %>; color: <%= c.textColor %>;"
           <% if (!c.url.startsWith('tel:') && !c.url.startsWith('mailto:')) { %>target="_blank" rel="noopener"<% } %>>
          <%= c.type %>
        </a>
      <% }); %>
    </nav>
  <% } %>
</header>
