<header class="site-header">
  <p class="company-name"><%= siteName || 'Заправка-Курск' %></p>
  <h1><%= heading %></h1>
  <p class="lead"><%= subheading %></p>

  <div class="hero-facts" aria-label="Преимущества">
    <span class="hero-fact">Выезд в день обращения</span>
    <span class="hero-fact">Гарантия на работы</span>
    <a class="hero-fact" href="/modeli">Каталог 50+ моделей →</a>
  </div>

  <% if (contacts.length > 0) { %>
    <nav class="contacts" aria-label="Контакты">
      <% contacts.forEach(function(c) { %>
        <a class="btn"
           href="<%= c.url %>"
           style="background: <%= c.color %>; color: <%= c.textColor %>;"
           <% if (!c.url.startsWith('tel:') && !c.url.startsWith('mailto:')) { %>target="_blank" rel="noopener"<% } %>>
          <%= c.type %>
        </a>
      <% }); %>
    </nav>
  <% } %>
</header>
