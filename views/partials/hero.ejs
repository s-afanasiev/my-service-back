<header class="site-header">
  <h1><%= heading %></h1>
  <p class="lead"><%= subheading %></p>

  <% if (contacts.length > 0) { %>
    <nav class="contacts" aria-label="Контакты">
      <% contacts.forEach(function(c) { %>
        <a class="btn"
           href="<%= c.url %>"
           style="background: <%= c.color %>; color: <%= c.textColor %>;"
           <% if (!c.url.startsWith('tel:')) { %>target="_blank" rel="noopener"<% } %>>
          <%= c.type %>
        </a>
      <% }); %>
    </nav>
  <% } %>
</header>
