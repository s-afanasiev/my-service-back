<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Редактирование модели</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: sans-serif; background: #f1f5f9; color: #1e293b; padding: 2rem 1rem; }
    h1   { font-size: 1.2rem; margin-bottom: 1.5rem; }

    .card {
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 2px 8px rgba(0,0,0,.07);
      padding: 1.5rem;
      max-width: 560px;
    }
    .row { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
    @media (max-width: 520px) { .row { grid-template-columns: 1fr; } }
    .checks { display: grid; grid-template-columns: 1fr 1fr; gap: .35rem 1rem; margin-bottom: 1rem; }

    .field { display: flex; flex-direction: column; gap: .3rem; margin-bottom: 1rem; }
    label  { font-size: .85rem; font-weight: 600; }
    input, select, textarea { padding: .5rem .7rem; border: 1px solid #cbd5e1; border-radius: 6px; font-size: .95rem; font-family: inherit; }
    input:focus, select:focus, textarea:focus { outline: 2px solid #2563eb; border-color: transparent; }
    textarea { resize: vertical; min-height: 5.5rem; }
    .check { flex-direction: row; align-items: center; gap: .5rem; font-weight: 500; }
    .preview { max-width: 100%; max-height: 140px; object-fit: contain; border-radius: 8px; background: #eef2f7; margin-bottom: .5rem; display: block; }

    .actions { display: flex; gap: .6rem; margin-top: 1.25rem; }
    button[type="submit"] {
      background: #2563eb; color: #fff;
      border: none; border-radius: 6px;
      padding: .5rem 1.2rem; font-size: .95rem; cursor: pointer;
    }
    button[type="submit"]:hover { background: #1d4ed8; }
    a.cancel {
      display: inline-flex; align-items: center;
      color: #64748b; font-size: .9rem; text-decoration: none;
      padding: .5rem .75rem; border-radius: 6px;
    }
    a.cancel:hover { background: #f1f5f9; }
  </style>
</head>
<body>

<h1>Модель на витрине</h1>

<div class="card">
  <form method="POST" action="/admin/featured/<%= printer.id %>/edit" enctype="multipart/form-data">

    <div class="field">
      <label for="brand">Бренд</label>
      <input id="brand" name="brand" type="text" value="<%= printer.brand %>" required />
    </div>

    <div class="field">
      <label for="model">Модель</label>
      <input id="model" name="model" type="text" value="<%= printer.model %>" required />
    </div>

    <div class="field">
      <label for="device_type">Тип</label>
      <select id="device_type" name="device_type">
        <option value="printer" <%= printer.device_type === 'printer' ? 'selected' : '' %>>Принтер</option>
        <option value="mfp" <%= printer.device_type === 'mfp' ? 'selected' : '' %>>МФУ</option>
      </select>
    </div>

    <div class="field">
      <label for="print_technology">Печать</label>
      <select id="print_technology" name="print_technology">
        <option value="laser" <%= printer.print_technology === 'laser' ? 'selected' : '' %>>лазер</option>
        <option value="inkjet" <%= printer.print_technology === 'inkjet' ? 'selected' : '' %>>струйный</option>
      </select>
    </div>

    <div class="field">
      <label for="color_mode">Цвет</label>
      <select id="color_mode" name="color_mode">
        <option value="mono" <%= printer.color_mode === 'mono' ? 'selected' : '' %>>ч/б</option>
        <option value="color" <%= printer.color_mode === 'color' ? 'selected' : '' %>>цветной</option>
      </select>
    </div>

    <div class="field">
      <label>Фото</label>
      <% if (printer.imageUrl) { %>
        <img class="preview" src="<%= printer.imageUrl %>" alt="" />
        <% if (printer.imageSource === 'upload') { %>
          <span style="font-size:.8rem;color:#64748b">Загружено на этот сервер</span>
          <label class="check"><input type="checkbox" name="remove_photo" /> Удалить загруженное фото</label>
        <% } else { %>
          <span style="font-size:.8rem;color:#64748b">Файл из репозитория: assets/printers/<%= printer.imageFile %></span>
        <% } %>
      <% } else { %>
        <span style="font-size:.8rem;color:#64748b">Пока схема. Положите снимок как <code>assets/printers/<%= printer.imageFile %></code> или загрузите файл ниже.</span>
      <% } %>
      <input name="photo" type="file" accept="image/jpeg,image/png,image/webp,image/gif" />
    </div>

    <div class="field">
      <label for="description">Описание (преимущества модели)</label>
      <textarea id="description" name="description" rows="4" maxlength="2000"
                placeholder="Чем удобна модель, для кого, какой картридж, что чиним"><%= printer.description || '' %></textarea>
    </div>

    <div class="row">
      <div class="field">
        <label for="paper_format">Формат бумаги</label>
        <input id="paper_format" name="paper_format" type="text" value="<%= printer.paper_format || '' %>" placeholder="A4" />
      </div>
      <div class="field">
        <label for="print_speed_ppm">Скорость, стр/мин</label>
        <input id="print_speed_ppm" name="print_speed_ppm" type="number" min="0" step="0.1" value="<%= printer.print_speed_ppm != null ? printer.print_speed_ppm : '' %>" />
      </div>
    </div>
    <div class="row">
      <div class="field">
        <label for="resolution_dpi">Разрешение печати</label>
        <input id="resolution_dpi" name="resolution_dpi" type="text" value="<%= printer.resolution_dpi || '' %>" placeholder="1200×1200" />
      </div>
      <div class="field">
        <label for="release_year">Год модели</label>
        <input id="release_year" name="release_year" type="number" min="1990" max="2100" value="<%= printer.release_year || '' %>" />
      </div>
    </div>
    <div class="row">
      <div class="field">
        <label for="cartridge_note">Картридж</label>
        <input id="cartridge_note" name="cartridge_note" type="text" value="<%= printer.cartridge_note || '' %>" placeholder="85A / CE285A" />
      </div>
      <div class="field">
        <label for="scan_resolution_dpi">Разрешение сканера</label>
        <input id="scan_resolution_dpi" name="scan_resolution_dpi" type="text" value="<%= printer.scan_resolution_dpi || '' %>" placeholder="для МФУ" />
      </div>
    </div>
    <div class="checks">
      <label class="check"><input type="checkbox" name="is_usb" <%= printer.is_usb ? 'checked' : '' %> /> USB</label>
      <label class="check"><input type="checkbox" name="is_wifi" <%= printer.is_wifi ? 'checked' : '' %> /> Wi‑Fi</label>
      <label class="check"><input type="checkbox" name="is_ethernet" <%= printer.is_ethernet ? 'checked' : '' %> /> Ethernet</label>
      <label class="check"><input type="checkbox" name="is_duplex" <%= printer.is_duplex ? 'checked' : '' %> /> Дуплекс</label>
      <label class="check"><input type="checkbox" name="has_adf" <%= printer.has_adf ? 'checked' : '' %> /> ADF (автоподатчик)</label>
    </div>

    <label class="field check">
      <input type="checkbox" name="is_active" <%= printer.is_active ? 'checked' : '' %> />
      Показывать на главной
    </label>

    <div class="actions">
      <button type="submit">Сохранить</button>
      <a class="cancel" href="/home">← Отмена</a>
    </div>
  </form>
</div>

</body>
</html>
